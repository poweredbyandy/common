<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_view_kanban_catalog_pba_order" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.pba.order</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='id']" position="after">
                <field name="default_code"/>
                <field name="internal_code"/>
                <field name="product_brand_id"/>
                <field name="free_qty"/>
            </xpath>
            <xpath expr="//t[@t-name='card']/div[@class='d-flex flex-grow-1 m-2']/div[1]" position="replace">
                <div class="p-2 pt-1 d-flex flex-column m-0 overflow-hidden"
                        t-attf-id="product-{{record.id.raw_value}}">
                    <div t-if="record.default_code.value" class="fw-bold fs-4 text-reset mb-1">
                        <field name="default_code"/>
                    </div>
                    <div t-if="record.internal_code.value">
                        <field name="internal_code"/>
                    </div>
                    <div t-if="record.product_brand_id.raw_value">
                        <field name="product_brand_id"/>
                    </div>
                    <div class="d-flex">
                        <field class="mt-1 me-1"
                            name="is_favorite"
                            widget="boolean_favorite"
                            nolabel="1"
                            readonly="1"/>
                        <field name="name" class="fw-bold fs-4 text-reset mb-1"/>
                    </div>
                    <div name="o_kanban_price"
                            t-attf-id="product-{{record.id.raw_value}}-price">
                    </div>
                    <div t-if="record.is_storable.raw_value"
                            name="o_kanban_qty_available">
                        <span>Disponible para vender: </span>
                        <field name="free_qty" nolabel="1"/>
                        <field name="uom_id" class="ms-1" groups="uom.group_uom"/>
                    </div>
                    <div name="o_kanban_pricelists"
                            t-attf-id="product-{{record.id.raw_value}}-pricelists">
                    </div>
                    <field name="product_template_attribute_value_ids"
                            widget="many2many_tags"
                            domain="[('id', 'in', parent.ids)]"
                            groups="product.group_product_variant"
                            options="{'color_field': 'color'}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
