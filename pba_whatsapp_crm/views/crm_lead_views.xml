<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_whatsapp" model="ir.ui.view">
        <field name="name">crm.lead.form.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="whatsapp_channel_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_whatsapp_tree_view" model="ir.ui.view">
        <field name="name">crm.lead.list.whatsapp</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
</odoo>
