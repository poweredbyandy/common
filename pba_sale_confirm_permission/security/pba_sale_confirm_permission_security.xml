<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_sale_confirm" model="ir.module.category">
        <field name="name">Confirmar pedidos de venta</field>
        <field name="description">Controla la visibilidad del botón Confirmar en pedidos de venta.</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_sale_order_confirm" model="res.groups">
        <field name="name">Confirmar pedidos de venta</field>
        <field name="category_id" ref="module_category_pba_sale_confirm"/>
        <field name="comment">Muestra el botón Confirmar en el pedido de venta. Por defecto se asigna a vendedores; se puede quitar por usuario.</field>
    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_sale_order_confirm'))]"/>
    </record>
</odoo>
