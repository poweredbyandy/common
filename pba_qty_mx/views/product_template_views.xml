<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_pba_qty_mx" model="ir.ui.view">
        <field name="name">product.template.form.pba.qty.mx</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='list_price_uom']" position="after">
                <label for="pba_qty_mx" groups="uom.group_uom"/>
                <div>
                    <field name="pba_qty_mx" groups="uom.group_uom"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
