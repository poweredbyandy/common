#. module: account_internal_transfer
#. odoo-python
msgid ""
"Internal transfers keep the same currency. Use a currency exchange when the journals "
"use different currencies."
msgstr ""
"Las transferencias internas mantienen la misma moneda. Use un cambio de divisa cuando"
" los diarios usan monedas distintas."

#. module: account_internal_transfer
msgid "Is Follower"
msgstr "Es un seguidor"

#. module: account_internal_transfer
#. odoo-python
#, python-format
msgid ""
"Journal %(journal)s needs a bank account or an outstanding account on its payment "
"method."
msgstr ""
"El diario %(journal)s necesita una cuenta de banco o una cuenta transitoria en su "
"método de pago."

#. module: account_internal_transfer
#. odoo-python
#, python-format
msgid "Journal %(journal)s uses %(journal_currency)s, which does not match %(currency)s."
msgstr "El diario %(journal)s usa %(journal_currency)s, que no coincide con %(currency)s."

#. module: account_internal_transfer
#. odoo-python
#, python-format
msgid "Journal %s has no payment method."
msgstr "El diario %s no tiene método de pago."

#. module: account_internal_transfer
