msgid "State"
msgstr "Estado"

#. module: account_internal_transfer
msgid "Status"
msgstr "Estado"

#. module: account_internal_transfer
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"Estado según las actividades\n"
"Vencida: la fecha límite ya pasó\n"
"Hoy: la fecha de la actividad es hoy\n"
"Planificada: actividades futuras."

#. module: account_internal_transfer
#. odoo-python
msgid "The amount must be positive."
msgstr "El importe debe ser positivo."

#. module: account_internal_transfer
msgid ""
"The amount that leaves is valued at the company rate on this date.\n"
"                        The amount that arrives follows the custom rate.\n"
"                        The difference is posted to the exchange gain or loss account."
msgstr ""
"El importe que sale se valora a la tasa de la compañía en esta fecha.\n"
"                        El importe que llega sigue la tasa personalizada.\n"
"                        El diferencial se publica en la cuenta de ganancia o pérdida "
"cambiaria."

#. module: account_internal_transfer
#. odoo-python
msgid "The custom rate must be positive."
msgstr "La tasa personalizada debe ser positiva."

#. module: account_internal_transfer
#. odoo-python
msgid "The destination amount must be positive."
msgstr "El importe destino debe ser positivo."

#. module: account_internal_transfer
#. odoo-python
#, python-format
msgid "The internal transfer account %(account)s must allow reconciliation."
msgstr "La cuenta de transferencia interna %(account)s debe permitir conciliación."

#. module: account_internal_transfer
#. odoo-python
msgid ""
"The internal transfer account cannot use a foreign currency, because each payment "
"keeps the currency of its journal."
msgstr ""
"La cuenta de transferencia interna no puede tener una moneda extranjera, porque cada "
"pago conserva la moneda de su diario."

#. module: account_internal_transfer
#. odoo-python
msgid "The source and destination journals must be different."
msgstr "El diario origen y el diario destino deben ser distintos."

#. module: account_internal_transfer
#. odoo-python
msgid "The transfer account lines do not balance and cannot be reconciled."
msgstr "Las líneas de la cuenta de transferencia no cuadran y no se pueden conciliar."

#. module: account_internal_transfer
msgid "Type of the exception activity on record."
msgstr "Tipo de actividad de excepción en el registro."

#. module: account_internal_transfer
msgid "Website Messages"
msgstr "Mensajes del sitio web"

#. module: account_internal_transfer
msgid "Website communication history"
msgstr "Historial de comunicación del sitio web"

#. module: account_internal_transfer
#. odoo-python
msgid "You can only delete a draft transfer."
msgstr "Solo puede eliminar una transferencia en borrador."

