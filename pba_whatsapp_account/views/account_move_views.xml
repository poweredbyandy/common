<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="pba_whatsapp_show_button" invisible="1"/>
                <button
                    name="action_pba_whatsapp_open_templates"
                    type="object"
                    string="WhatsApp"
                    icon="fa-whatsapp"
                    class="btn-secondary"
                    invisible="not pba_whatsapp_show_button"
                />
            </xpath>
        </field>
    </record>
</odoo>
