<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="WhatsApp Contabilidad">
                    <setting id="whatsapp_template_overdue_setting" string="Plantilla mora">
                        <field name="whatsapp_template_overdue_id"/>
                    </setting>
                    <setting
                        id="whatsapp_overdue_auto_send_setting"
                        string="Recordatorio automático"
                    >
                        <field name="whatsapp_overdue_auto_send"/>
                        <div class="content-group" invisible="not whatsapp_overdue_auto_send">
                            <label for="whatsapp_overdue_days" string="Días mínimos de mora"/>
                            <field name="whatsapp_overdue_days"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
