<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_treasury_payment_assign_view_form" model="ir.ui.view">
        <field name="name">account.treasury.payment.assign.form</field>
        <field name="model">account.treasury.payment.assign</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="payment_id"/>
                        <field name="partner_id" invisible="not partner_id"/>
                        <field name="flow_type"/>
                    </group>
                    <group>
                        <field name="available_amount"/>
                        <field name="partner_only" invisible="not partner_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                        <field name="date"/>
                        <field name="name"/>
                        <field name="partner_id" optional="show"/>
                        <field name="category_id" optional="show"/>
                        <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-warning="state == 'partial'"/>
                        <field name="amount_residual" sum="Total"/>
                        <field name="amount" readonly="not selected"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="forecast_id" column_invisible="True" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Assign" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
