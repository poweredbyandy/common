<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_account_treasury" model="ir.module.category">
        <field name="name">Treasury</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_account_treasury_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_account_treasury"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_account_treasury_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_account_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_account_treasury_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
