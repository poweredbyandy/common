<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="account_treasury_category_rule_company" model="ir.rule">
        <field name="name">Treasury category: multi-company</field>
        <field name="model_id" ref="model_account_treasury_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_treasury_template_rule_company" model="ir.rule">
        <field name="name">Treasury recurring movement: multi-company</field>
        <field name="model_id" ref="model_account_treasury_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_treasury_forecast_rule_company" model="ir.rule">
        <field name="name">Treasury forecast: multi-company</field>
        <field name="model_id" ref="model_account_treasury_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_treasury_match_rule_company" model="ir.rule">
        <field name="name">Treasury real movement: multi-company</field>
        <field name="model_id" ref="model_account_treasury_match"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
