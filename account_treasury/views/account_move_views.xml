<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.treasury</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string="Treasury" name="treasury_group" invisible="not treasury_forecast_id" groups="account_treasury.group_account_treasury_user">
                    <field name="treasury_forecast_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
