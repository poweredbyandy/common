<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_treasury_category_view_list" model="ir.ui.view">
        <field name="name">account.treasury.category.list</field>
        <field name="model">account.treasury.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="flow_type"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="account_treasury_category_view_search" model="ir.ui.view">
        <field name="name">account.treasury.category.search</field>
        <field name="model">account.treasury.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="inflow" string="Inflows" domain="[('flow_type', '=', 'inflow')]"/>
                <filter name="outflow" string="Outflows" domain="[('flow_type', '=', 'outflow')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="account_treasury_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">account.treasury.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
