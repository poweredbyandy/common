<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.dialog.size</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <group name="preferences" position="inside">
                <group string="Diálogos">
                    <field name="dialog_default_maximize" readonly="0" />
                </group>
            </group>
        </field>
    </record>

    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form.dialog.size</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <group name="preferences" position="after">
                <group string="Diálogos">
                    <field name="dialog_default_maximize" />
                </group>
            </group>
        </field>
    </record>
</odoo>
