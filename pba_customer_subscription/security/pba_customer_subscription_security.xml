<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_pba_customer_subscription" model="ir.module.category">
        <field name="name">Customer Support</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_support_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_pba_customer_subscription" />
        <field name="comment">
            Can create, edit and view own support tickets.
        </field>
    </record>

    <record id="group_support_helpdesk" model="res.groups">
        <field name="name">Helpdesk</field>
        <field name="category_id" ref="module_category_pba_customer_subscription" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_support_user'))]"
        />
        <field name="comment">
            Can create, edit and view all tickets, and approve tickets before sending.
        </field>
    </record>

    <record id="group_support_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_pba_customer_subscription" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_support_helpdesk'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
        <field name="comment">
            Can view all tickets and financial summary (invoices and pending payments).
        </field>
    </record>

    <record id="pba_customer_ticket_track_rule_user" model="ir.rule">
        <field name="name">Support track: own tickets</field>
        <field name="model_id" ref="model_pba_customer_ticket_track" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_support_user'))]" />
    </record>

    <record id="pba_customer_ticket_track_rule_helpdesk" model="ir.rule">
        <field name="name">Support track: helpdesk all</field>
        <field name="model_id" ref="model_pba_customer_ticket_track" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('group_support_helpdesk')), (4, ref('group_support_admin'))]"
        />
    </record>
</odoo>
