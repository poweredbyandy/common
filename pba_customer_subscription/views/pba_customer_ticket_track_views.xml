<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pba_customer_ticket_track_view_list" model="ir.ui.view">
        <field name="name">pba.customer.ticket.track.view.list</field>
        <field name="model">pba.customer.ticket.track</field>
        <field name="arch" type="xml">
            <list string="Support Notifications">
                <field name="ticket_number" />
                <field name="name" />
                <field name="user_id" />
                <field name="last_support_preview" />
                <field name="write_date" />
            </list>
        </field>
    </record>

    <record id="pba_customer_ticket_track_view_form" model="ir.ui.view">
        <field name="name">pba.customer.ticket.track.view.form</field>
        <field name="model">pba.customer.ticket.track</field>
        <field name="arch" type="xml">
            <form string="Support Notification">
                <header>
                    <button
                        name="action_open_support_dashboard"
                        type="object"
                        string="Open Support"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="display_name" />
                        <field name="ticket_number" />
                        <field name="provider_ticket_id" />
                        <field name="user_id" />
                        <field name="client_user_login" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="last_support_preview" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="pba_customer_ticket_track_action" model="ir.actions.act_window">
        <field name="name">Support Notifications</field>
        <field name="res_model">pba.customer.ticket.track</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
