<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock.action_view_inventory_tree" model="ir.actions.server">
        <field name="groups_id" eval="[(6, 0, [ref('pba_stock_qty_access.group_pba_stock_qty_adjust')])]"/>
    </record>

    <record id="stock.menu_action_inventory_tree" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('pba_stock_qty_access.group_pba_stock_qty_adjust')])]"/>
    </record>

    <record id="stock.dashboard_open_quants" model="ir.actions.act_window">
        <field name="groups_id" eval="[(6, 0, [ref('pba_stock_qty_access.group_pba_stock_qty_adjust')])]"/>
    </record>

    <record id="stock.action_view_set_quants_tree" model="ir.actions.server">
        <field name="groups_id" eval="[(6, 0, [ref('pba_stock_qty_access.group_pba_stock_qty_adjust')])]"/>
    </record>

    <record id="stock.action_change_product_quantity" model="ir.actions.act_window">
        <field name="groups_id" eval="[(6, 0, [ref('pba_stock_qty_access.group_pba_stock_qty_adjust')])]"/>
    </record>

    <record id="view_stock_quant_tree_inventory_editable_pba_qty_access" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.pba.qty.access</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_apply_all']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
            <xpath expr="//button[@name='stock.action_stock_inventory_adjustement_name']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
            <xpath expr="//field[@name='inventory_quantity']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
            <xpath expr="//button[@name='action_set_inventory_quantity']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
            <xpath expr="//button[@name='action_clear_inventory_quantity']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_pba_qty_access" model="ir.ui.view">
        <field name="name">stock.quant.list.pba.qty.access</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="edit">0</attribute>
                <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_pba_qty_access" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.pba.qty.access</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="edit">1</attribute>
                <attribute name="create">1</attribute>
            </xpath>
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="attributes">
                <attribute name="groups">pba_stock_qty_access.group_pba_stock_qty_adjust</attribute>
            </xpath>
        </field>
    </record>
</odoo>
