<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_nota_despacho_impresora" model="report.paperformat">
        <field name="name">Nota despacho (impresora matriz / nítido)</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">48</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">48</field>
        <field name="dpi">130</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="css_margins" eval="True"/>
    </record>
    <record id="action_report_stock_picking_dispatch_pdf" model="ir.actions.report">
        <field name="name">Nota de despacho (PDF)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock.report_deliveryslip</field>
        <field name="report_file">stock.report_deliveryslip</field>
        <field name="print_report_name">'Nota_despacho_%s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_nota_despacho_impresora"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
    </record>
</odoo>
