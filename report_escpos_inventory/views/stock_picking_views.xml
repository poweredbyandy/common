<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_view_form_dispatch_reports" model="ir.ui.view">
        <field name="name">stock.picking.form.dispatch.reports</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="after">
                <button
                    name="%(action_report_stock_picking_dispatch_escpos)d"
                    type="action"
                    string="Dispatch Note (ESC/P)"
                    groups="stock.group_stock_user"
                    invisible="state not in ('assigned', 'done')"
                />
                <button
                    name="%(action_report_stock_picking_dispatch_pdf)d"
                    type="action"
                    string="Dispatch Note (PDF)"
                    groups="stock.group_stock_user"
                    invisible="state not in ('assigned', 'done')"
                />
            </xpath>
        </field>
    </record>
</odoo>
