<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_pba_line_number" model="ir.ui.view">
        <field name="name">purchase.order.form.pba.line.number</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="before">
                <field name="pba_line_number" string="#" readonly="1" width="40px"/>
            </xpath>
        </field>
    </record>
</odoo>
