<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_users_user_rule_user" model="ir.rule">
        <field name="name">Sub-user: own user only</field>
        <field name="model_id" ref="model_res_users_user" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="res_users_user_rule_system" model="ir.rule">
        <field name="name">Sub-user: system all</field>
        <field name="model_id" ref="model_res_users_user" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>

    <record id="res_users_user_log_rule_user" model="ir.rule">
        <field name="name">Sub-user log: own user only</field>
        <field name="model_id" ref="model_res_users_user_log" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="res_users_user_log_rule_system" model="ir.rule">
        <field name="name">Sub-user log: system all</field>
        <field name="model_id" ref="model_res_users_user_log" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
