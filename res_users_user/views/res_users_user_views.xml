<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_users_user_view_list" model="ir.ui.view">
        <field name="name">res.users.user.list</field>
        <field name="model">res.users.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="user_id" />
                <field name="employee_id" />
                <field name="pin" password="True" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="res_users_user_view_form" model="ir.ui.view">
        <field name="name">res.users.user.form</field>
        <field name="model">res.users.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id" />
                        <field name="employee_id" />
                        <field name="name" />
                        <field
                            name="pin"
                            password="True"
                            required="active"
                        />
                        <field name="active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_users_user_log_view_list" model="ir.ui.view">
        <field name="name">res.users.user.log.list</field>
        <field name="model">res.users.user.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date" />
                <field name="sub_user_id" />
                <field name="user_id" />
                <field name="method" />
                <field name="model" />
                <field name="res_id" />
                <field name="res_name" />
            </list>
        </field>
    </record>

    <record id="res_users_user_action" model="ir.actions.act_window">
        <field name="name">Sub-Users</field>
        <field name="res_model">res.users.user</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_users_user_log_action" model="ir.actions.act_window">
        <field name="name">Sub-User Logs</field>
        <field name="res_model">res.users.user.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="res_users_user_menu"
        name="Sub-Users"
        parent="base.menu_users"
        action="res_users_user_action"
        sequence="50"
        groups="base.group_system"
    />
    <menuitem
        id="res_users_user_log_menu"
        name="Sub-User Logs"
        parent="base.menu_users"
        action="res_users_user_log_action"
        sequence="51"
        groups="base.group_system"
    />
</odoo>
