<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_sub_user" model="ir.ui.view">
        <field name="name">hr.employee.form.sub.user</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_sub_users"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-users"
                    groups="base.group_system"
                >
                    <field name="sub_user_count" widget="statinfo" string="Sub-Users" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
