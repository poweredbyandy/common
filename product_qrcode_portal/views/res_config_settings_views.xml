<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product.qrcode.portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="sale_product_catalog_settings" position="after">
                <block title="Product QR URL" id="product_qr_portal_settings">
                    <setting
                        id="product_qr_portal_action_setting"
                        string="On scan of product QR URL"
                        help="What happens when a visitor scans the portal URL printed on a product (/product-qr?code=...)."
                    >
                        <span class="fa fa-lg fa-globe" title="Values set here are website-specific." groups="website.group_multi_website"/>
                        <div class="content-group">
                            <div class="row mt16 ms-4">
                                <field name="product_qr_portal_action" widget="radio" required="0"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
