<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_label_layout_form_portal_qr" model="ir.ui.view">
        <field name="name">product.label.layout.form.portal.qr</field>
        <field name="model">product.label.layout</field>
        <field name="inherit_id" ref="product.product_label_layout_form"/>
        <field name="arch" type="xml">
            <field name="print_format" position="after">
                <field
                    name="portal_qr_website_id"
                    invisible="print_format != 'qr_label_url'"
                    options="{'no_create': True}"
                />
            </field>
        </field>
    </record>
</odoo>
