<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_view_form_group_ids" model="ir.ui.view">
        <field name="name">product.pricelist.form.group.ids</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pricelist_settings']" position="inside">
                <field
                    name="group_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    domain="[('id', 'not in', [ %(base.group_user)d, %(base.group_portal)d, %(base.group_public)d ])]"
                    placeholder="Empty = visible to everyone"
                />
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_view_tree_group_ids" model="ir.ui.view">
        <field name="name">product.pricelist.list.group.ids</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field
                    name="group_ids"
                    widget="many2many_tags"
                    options="{'no_create': True}"
                    domain="[('id', 'not in', [ %(base.group_user)d, %(base.group_portal)d, %(base.group_public)d ])]"
                    optional="show"
                    placeholder="Empty = visible to everyone"
                />
            </xpath>
        </field>
    </record>
</odoo>
