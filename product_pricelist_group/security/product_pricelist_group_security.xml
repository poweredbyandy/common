<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_product_pricelist_group" model="ir.module.category">
        <field name="name">Pricelist Visibility</field>
        <field name="description">Control who can see restricted pricelists.</field>
        <field name="sequence">97</field>
    </record>

    <record id="group_product_pricelist_all" model="res.groups">
        <field name="name">See all pricelists</field>
        <field name="category_id" ref="module_category_product_pricelist_group"/>
        <field name="comment">Users in this group can see every pricelist. Implied by Settings.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_product_pricelist_all'))]"/>
    </record>

    <record id="product_pricelist_group_rule_user" model="ir.rule">
        <field name="name">Pricelist: empty=public, else matching groups</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="product_pricelist_group_rule_manager" model="ir.rule">
        <field name="name">Pricelist: see all</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_product_pricelist_all')])]"/>
        <field name="active" eval="True"/>
    </record>

    <record id="product_pricelist_item_group_rule_user" model="ir.rule">
        <field name="name">Pricelist item: empty=public, else matching groups</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">['|', ('pricelist_id.group_ids', '=', False), ('pricelist_id.group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="product_pricelist_item_group_rule_manager" model="ir.rule">
        <field name="name">Pricelist item: see all</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_product_pricelist_all')])]"/>
        <field name="active" eval="True"/>
    </record>

    <record id="product_pricelist_group_rule_on_my_orders" model="ir.rule">
        <field name="name">Pricelist: used on my sale orders</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>

    <record id="product_pricelist_item_group_rule_on_my_orders" model="ir.rule">
        <field name="name">Pricelist item: used on my sale orders</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="active" eval="False"/>
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
</odoo>
