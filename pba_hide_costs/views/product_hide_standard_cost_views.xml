<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_hide_standard_cost" model="ir.ui.view">
        <field name="name">product.template.form.hide.standard.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@id='standard_price_label']" position="attributes">
                <attribute name="groups">pba_hide_costs.group_pba_product_cost_visible</attribute>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="groups">pba_hide_costs.group_pba_product_cost_visible</attribute>
            </xpath>
        </field>
    </record>
