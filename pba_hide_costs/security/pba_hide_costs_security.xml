<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_hide_costs" model="ir.module.category">
        <field name="name">PBA Costos producto</field>
        <field name="description">Control de visibilidad del costo estándar en productos.</field>
        <field name="sequence">96</field>
    </record>
    <record id="group_pba_product_cost_visible" model="res.groups">
        <field name="name">PBA: Ver costo de producto</field>
        <field name="category_id" ref="module_category_pba_hide_costs"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pba_product_cost_visible'))]"/>
    </record>
</odoo>
