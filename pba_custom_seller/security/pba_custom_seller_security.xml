<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_custom_seller" model="ir.module.category">
        <field name="name">PBA Custom Seller</field>
        <field name="description">Limited seller visibility for contacts, products and stock quantities.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_pba_custom_seller" model="res.groups">
        <field name="name">PBA: Custom Seller</field>
        <field name="category_id" ref="module_category_pba_custom_seller"/>
        <field name="comment">Limited seller: own contacts and products from allowed pricelists only.</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('product.group_product_pricelist'))]"/>
    </record>

    <record id="group_pba_custom_seller_see_qty" model="res.groups">
        <field name="name">PBA: Custom Seller see stock quantities</field>
        <field name="category_id" ref="module_category_pba_custom_seller"/>
        <field name="comment">Allows custom sellers to see on-hand / forecasted stock quantities.</field>
        <field name="implied_ids" eval="[(4, ref('group_pba_custom_seller'))]"/>
    </record>

    <record id="group_pba_custom_seller_confirm_so" model="res.groups">
        <field name="name">PBA: Custom Seller confirm quotations</field>
        <field name="category_id" ref="module_category_pba_custom_seller"/>
        <field name="comment">Allows custom sellers to confirm sale quotations.</field>
        <field name="implied_ids" eval="[(4, ref('group_pba_custom_seller'))]"/>
    </record>

    <record id="res_partner_rule_pba_custom_seller" model="ir.rule">
        <field name="name">PBA Custom Seller: own partners and internal users</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('id', '=', user.partner_id.id), ('user_ids.share', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_pba_custom_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="res_partner_rule_pba_custom_seller_sale_orders" model="ir.rule">
        <field name="name">PBA Custom Seller: partners on assigned sale orders</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', '|', ('sale_order_ids.user_id', '=', user.id), ('pba_sale_order_as_invoice_ids.user_id', '=', user.id), ('pba_sale_order_as_shipping_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pba_custom_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
