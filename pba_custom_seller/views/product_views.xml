<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_product_tree_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.product.list.pba.custom.seller.qty</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.view_stock_product_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//field[@name='type']" position="after">
                <field
                    name="qty_available"
                    invisible="not is_storable"
                    string="On Hand"
                    optional="show"
                    decoration-danger="virtual_available &lt; 0"
                    decoration-warning="virtual_available == 0"
                    decoration-bf="1"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                />
                <field
                    name="virtual_available"
                    invisible="not is_storable"
                    string="Forecasted"
                    optional="show"
                    decoration-danger="virtual_available &lt; 0"
                    decoration-warning="virtual_available == 0"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_product_template_tree_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.template.list.pba.custom.seller.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//field[@name='show_on_hand_qty_status_button']" position="after">
                <field
                    name="qty_available"
                    invisible="not show_on_hand_qty_status_button"
                    string="On Hand"
                    optional="show"
                    decoration-danger="qty_available &lt; 0"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                />
                <field
                    name="virtual_available"
                    invisible="not show_on_hand_qty_status_button"
                    string="Forecasted"
                    optional="show"
                    decoration-danger="virtual_available &lt; 0"
                    decoration-bf="1"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                />
            </xpath>
        </field>
    </record>

    <record id="product_view_kanban_catalog_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.pba.custom.seller.qty</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_view_kanban_catalog"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='o_kanban_qty_available']" position="attributes">
                <attribute name="groups">!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//div[@name='o_kanban_price']" position="after">
                <div
                    t-if="record.is_storable.raw_value"
                    name="o_kanban_qty_available_pba"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >
                    <span>On Hand: </span>
                    <field name="qty_available"/>
                    <field name="uom_id" class="ms-1" groups="uom.group_uom"/>
                </div>
            </xpath>
            <xpath expr="//a[@name='action_product_forecast_report']" position="attributes">
                <attribute name="groups">!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//a[@name='action_product_forecast_report']" position="after">
                <a
                    role="menuitem"
                    type="object"
                    name="action_product_forecast_report"
                    class="dropdown-item border-top-0"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >View Availability</a>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_stock_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.template.kanban.stock.pba.custom.seller.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_kanban_stock_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@groups='stock.group_stock_user']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//field[@name='product_properties']" position="before">
                <div
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                    t-if="record.show_on_hand_qty_status_button.raw_value"
                >
                    On hand: <field name="qty_available"/> <field name="uom_id" groups="uom.group_uom"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_form_view_procurement_button_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.product.form.pba.custom.seller.qty</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_update_quantity_on_hand'][@icon='fa-cubes']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//button[@name='action_product_forecast_report']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//button[@name='action_product_forecast_report']" position="after">
                <button
                    class="oe_stat_button"
                    name="action_update_quantity_on_hand"
                    icon="fa-cubes"
                    type="object"
                    context="{'product_variant': True}"
                    invisible="not show_on_hand_qty_status_button"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex gap-1">
                            <field name="qty_available" nolabel="1" class="oe_inline"/>
                            <field name="uom_name" class="oe_inline" groups="uom.group_uom"/>
                        </span>
                        <span class="o_stat_text">On Hand</span>
                    </div>
                </button>
                <button
                    type="object"
                    name="action_product_forecast_report"
                    invisible="not show_forecasted_qty_status_button"
                    context="{'default_product_id': id, 'active_model': 'product.template'}"
                    class="oe_stat_button"
                    icon="fa-area-chart"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex gap-1">
                            <field name="virtual_available" class="oe_inline"/>
                            <field name="uom_name" class="oe_inline" groups="uom.group_uom"/>
                        </span>
                        <span class="o_stat_text">Forecasted</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_procurement_button_pba_custom_seller_qty" model="ir.ui.view">
        <field name="name">product.template.form.pba.custom.seller.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_update_quantity_on_hand'][@icon='fa-cubes']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="attributes">
                <attribute name="groups">stock.group_stock_user,!pba_custom_seller.group_pba_custom_seller</attribute>
            </xpath>
            <xpath expr="//button[@name='action_product_tmpl_forecast_report']" position="after">
                <button
                    type="object"
                    name="action_update_quantity_on_hand"
                    invisible="not show_on_hand_qty_status_button"
                    class="oe_stat_button"
                    icon="fa-cubes"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex gap-1">
                            <field name="qty_available" nolabel="1" class="oe_inline"/>
                            <field name="uom_name" class="oe_inline" groups="uom.group_uom"/>
                        </span>
                        <span class="o_stat_text">On Hand</span>
                    </div>
                </button>
                <button
                    type="object"
                    name="action_product_tmpl_forecast_report"
                    invisible="not show_forecasted_qty_status_button"
                    context="{'default_product_tmpl_id': id}"
                    class="oe_stat_button"
                    icon="fa-area-chart"
                    groups="pba_custom_seller.group_pba_custom_seller_see_qty"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value d-flex gap-1">
                            <field name="virtual_available" nolabel="1" class="oe_inline"/>
                            <field name="uom_name" class="oe_inline" groups="uom.group_uom"/>
                        </span>
                        <span class="o_stat_text">Forecasted</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
