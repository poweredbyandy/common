<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form_excess_refund" model="ir.ui.view">
        <field name="name">account.move.form.excess.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[hasclass('oe_subtotal_footer')]/field[@name='amount_residual']"
                position="after"
            >
                <field name="has_excess_refunded" invisible="1" />
                <field name="has_excess_to_refund" invisible="1" />
                <field
                    name="excess_refund_payments_widget"
                    colspan="2"
                    nolabel="1"
                    widget="excess_refund"
                    invisible="not has_excess_refunded"
                    groups="account.group_account_invoice,account.group_account_readonly"
                />
                <field
                    name="excess_to_refund_widget"
                    class="oe_invoice_outstanding_credits_debits py-3"
                    colspan="2"
                    nolabel="1"
                    widget="excess_refund"
                    invisible="not has_excess_to_refund"
                    groups="account.group_account_invoice,account.group_account_readonly"
                />
            </xpath>
        </field>
    </record>
</odoo>
