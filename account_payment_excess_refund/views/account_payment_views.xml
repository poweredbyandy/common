<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_form_excess_refund" model="ir.ui.view">
        <field name="name">account.payment.form.excess.refund</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_excess_refund_cancel"
                    type="object"
                    string="Cancel Excess Payment"
                    invisible="state == 'canceled' or not excess_refund_invoice_id"
                    groups="account.group_account_invoice"
                    confirm="Cancel this excess refund payment and its journal entry?"
                />
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field
                    name="excess_refund_invoice_id"
                    readonly="1"
                    invisible="not excess_refund_invoice_id"
                />
                <field
                    name="excess_refund_line_id"
                    readonly="1"
                    invisible="not excess_refund_line_id"
                />
                <field
                    name="excess_refund_source_payment_id"
                    readonly="1"
                    invisible="not excess_refund_source_payment_id"
                />
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_excess_refund_list" model="ir.ui.view">
        <field name="name">account.payment.excess.refund.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Excess Refunds" create="false" multi_edit="0">
                <header>
                    <button
                        name="action_excess_refund_cancel"
                        type="object"
                        string="Cancel"
                        groups="account.group_account_invoice"
                        confirm="Cancel the selected excess refund payment(s) and their journal entries?"
                    />
                </header>
                <field name="date" />
                <field name="name" />
                <field name="partner_id" />
                <field name="payment_type" />
                <field name="amount" sum="Total" />
                <field name="currency_id" optional="show" />
                <field name="journal_id" />
                <field name="state" widget="badge" />
                <field name="excess_refund_source_payment_id" optional="show" />
                <field name="move_id" optional="show" />
            </list>
        </field>
    </record>
</odoo>
