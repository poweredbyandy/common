<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_company_property_sync_wizard_form" model="ir.ui.view">
        <field name="name">res.partner.company.property.sync.wizard.form</field>
        <field name="model">res.partner.company.property.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sincronizar propiedades entre compañías">
                <group>
                    <field name="source_company_id"/>
                    <field name="target_company_ids" widget="many2many_tags"/>
                </group>
                <group string="Campos">
                    <field
                        name="sync_field_ids"
                        widget="many2many_tags"
                        nolabel="1"
                        options="{'no_create': True, 'no_open': True}"
                    />
                </group>
                <group string="Contactos">
                    <field name="partner_ids" widget="many2many_tags" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_sync" type="object" string="Sincronizar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_company_property_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sincronizar propiedades entre compañías</field>
        <field name="res_model">res.partner.company.property.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_partner_company_property_sync_wizard"
        name="Sincronizar propiedades de contactos"
        parent="contacts.menu_contacts"
        action="action_partner_company_property_sync_wizard"
        sequence="90"
        groups="account.group_account_manager,base.group_partner_manager"
    />
</odoo>
