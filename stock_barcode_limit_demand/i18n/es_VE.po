#. module: stock_barcode_limit_demand
#: model:ir.model.fields,field_description:stock_barcode_limit_demand.field_stock_picking_type__barcode_block_over_demand
msgid "Block Over-Demand Scans"
msgstr "Bloquear lecturas por encima de lo solicitado"

#. module: stock_barcode_limit_demand
#: model:ir.model.fields,help:stock_barcode_limit_demand.field_stock_picking_type__barcode_block_over_demand
msgid "When enabled, the Barcode app rejects scans that would pick, receive, or move more units than the requested quantity on the transfer."
msgstr "Si está activo, la app Código de barras rechaza lecturas que superen la cantidad solicitada en la transferencia."

#. module: stock_barcode_limit_demand
#. odoo-javascript
#: code:addons/stock_barcode_limit_demand/static/src/js/barcode_picking_model.js:0
msgid "You cannot scan more than the requested quantity (%(demand)s) for %(product)s."
msgstr "No puede leer más de la cantidad solicitada (%(demand)s) para %(product)s."
