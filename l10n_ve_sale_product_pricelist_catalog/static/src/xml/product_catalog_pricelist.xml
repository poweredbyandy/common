<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="l10n_ve_sale_product_pricelist_catalog.ProductCatalogOrderLinePricelist"
        t-inherit="product.ProductCatalogOrderLine"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//t[@t-portal]" position="before">
            <t
                t-portal="`#product-${props.productId}-pricelists-panel`"
                t-if="this.showPricelists"
            >
                <div class="o_product_catalog_pricelists w-100 border-top border-bottom">
                    <table
                        class="table table-borderless table-sm mb-0 o_product_catalog_pricelist_table"
                    >
                        <tbody>
                            <t
                                t-foreach="pricelists"
                                t-as="pricelist"
                                t-key="pricelist.id"
                            >
                                <tr>
                                    <td
                                        class="o_product_catalog_pricelist_name text-muted"
                                        t-att-title="pricelist.name"
                                    >
                                        <span t-out="pricelist.name" />
                                    </td>
                                    <td
                                        t-if="showForeignPriceColumn"
                                        class="o_product_catalog_pricelist_price text-end text-nowrap"
                                    >
                                        <t
                                            t-if="pricelist.currency_id != pricelist.company_currency_id"
                                        >
                                            <span
                                                t-out="formatPrice(pricelist.price, pricelist.currency_id, [false, 2])"
                                            />
                                        </t>
                                        <t t-else="">—</t>
                                    </td>
                                    <td
                                        class="o_product_catalog_pricelist_price text-end text-nowrap fw-bold"
                                    >
                                        <span
                                            t-out="formatPrice(pricelist.company_currency_price, pricelist.company_currency_id, [false, 2])"
                                        />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </t>
</templates>
