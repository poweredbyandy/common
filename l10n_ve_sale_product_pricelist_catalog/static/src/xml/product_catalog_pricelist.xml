<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="l10n_ve_sale_product_pricelist_catalog.ProductCatalogOrderLinePricelist"
        t-inherit="product.ProductCatalogOrderLine"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//t[@t-portal]" position="before">
            <t
                t-portal="`#product-${props.productId}-pricelists`"
                t-if="this.showPricelists"
            >
                <div
                    class="o_product_catalog_pricelists mt-2 pt-2 pb-2 mb-2 border-top border-bottom"
                >
                    <table class="table table-borderless table-striped table-sm">
                        <tbody>
                            <t
                                t-foreach="pricelists"
                                t-as="pricelist"
                                t-key="pricelist.id"
                            >
                                <tr>
                                    <td class="text-nowrap">
                                        <span
                                            class="text-muted"
                                            t-out="pricelist.name"
                                        />
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <t
                                            t-if="pricelist.currency_id != pricelist.company_currency_id"
                                        >
                                            <span
                                                class="fw-bold text-end "
                                                t-out="formatPrice(pricelist.price, pricelist.currency_id, [false, 2])"
                                            />
                                        </t>
                                    </td>
                                    <td class="text-end ">
                                        <span
                                            class="fw-bold"
                                            t-out="formatPrice(pricelist.company_currency_price, pricelist.company_currency_id, [false, 2])"
                                        />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </t>
</templates>
