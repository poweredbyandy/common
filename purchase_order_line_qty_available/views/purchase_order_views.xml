<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_qty_available" model="ir.ui.view">
        <field name="name">purchase.order.form.qty.available</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="qty_available" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//div[hasclass('o_row')][field[@name='product_qty']]" position="after">
                <field name="qty_available" readonly="1" invisible="display_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/kanban//field[@name='product_qty']" position="after">
                <span class="text-muted">
                    On Hand:
                    <field name="qty_available"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_list_qty_available" model="ir.ui.view">
        <field name="name">purchase.order.line.list.qty.available</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="after">
                <field name="qty_available" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_form_qty_available" model="ir.ui.view">
        <field name="name">purchase.order.line.form.qty.available</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_row')][field[@name='product_qty']]" position="after">
                <field name="qty_available" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
