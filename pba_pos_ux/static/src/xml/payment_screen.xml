<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-screen')][hasclass('p-2')]/t[@t-call='point_of_sale.PaymentScreenMethods']" position="replace"/>
        <xpath expr="//div[hasclass('payment-screen')][hasclass('p-2')]/div[hasclass('flex-grow-1')][hasclass('overflow-y-auto')]" position="after">
            <t t-call="point_of_sale.PaymentScreenMethods"/>
        </xpath>
        <xpath expr="//div[hasclass('payment-screen')][hasclass('p-2')]/div[hasclass('flex-grow-1')][hasclass('overflow-y-auto')]" position="attributes">
            <attribute name="class" add="pba_pos_ux_payment_lines_pane" separator=" "/>
        </xpath>
    </t>
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods-container')]" position="before">
            <button
                t-if="ui.isSmall"
                type="button"
                class="btn btn-lg w-100 my-1 pba_pos_ux_add_payment_btn d-flex align-items-center justify-content-center"
                t-att-class="{
                    'btn-primary': !pbaPaymentUi.methodsOpen,
                    'btn-light': pbaPaymentUi.methodsOpen,
                }"
                t-on-click="() => this.pbaTogglePaymentMethods()"
            >
                <i
                    class="fa me-2"
                    t-att-class="{
                        'fa-plus': !pbaPaymentUi.methodsOpen,
                        'fa-chevron-up': pbaPaymentUi.methodsOpen,
                    }"
                />
                <span t-if="!pbaPaymentUi.methodsOpen">Agregar pago</span>
                <span t-else="">Métodos de pago</span>
            </button>
        </xpath>
        <xpath expr="//div[hasclass('paymentmethods-container')]" position="attributes">
            <attribute name="t-if">!ui.isSmall or pbaPaymentUi.methodsOpen</attribute>
            <attribute name="class" add="pba_pos_ux_paymentmethods_panel" separator=" "/>
        </xpath>
    </t>
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]/div[hasclass('d-flex')][1]" position="attributes">
            <attribute name="class">d-flex flex-column gap-2 w-100</attribute>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute name="class">button partner-button btn btn-light btn-lg d-flex align-items-start w-100 lh-sm text-start text-wrap</attribute>
        </xpath>
        <xpath expr="//span[hasclass('partner-name')]" position="replace">
            <span class="partner-name flex-grow-1 text-wrap">
                <t t-if="currentOrder.get_partner()">
                    <div t-esc="currentOrder.get_partner().name"/>
                    <div
                        t-if="currentOrder.get_partner().vat"
                        class="small opacity-75"
                        t-esc="currentOrder.get_partner().vat"
                    />
                </t>
                <t t-else="">Customer</t>
            </span>
        </xpath>
    </t>
</templates>
