<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="replace">
            <div class="pba_pos_ux_product_label flex-grow-1 min-w-0 my-2 overflow-hidden">
                <div
                    t-if="productReference and !isListView"
                    class="pba_pos_ux_product_ref"
                    t-esc="'[' + productReference + ']'"
                />
                <div
                    class="overflow-hidden lh-sm product-name"
                    t-att-class="{
                        'no-image d-flex justify-content-center align-items-center text-center fs-4': !props.imageUrl and !productReference,
                        'pba_pos_ux_product_name_card': !isListView,
                    }"
                    t-attf-id="article_product_{{props.productId}}"
                    t-esc="displayedProductName"
                />
            </div>
        </xpath>
    </t>
</templates>
