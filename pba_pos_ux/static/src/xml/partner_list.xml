<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="bodyClass">props.forceCustomer ? 'partner-list overflow-y-auto pba_pos_ux_force_customer' : 'partner-list overflow-y-auto'</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o-default-button')]" position="replace">
            <button
                t-if="!props.forceCustomer"
                class="btn btn-secondary btn-lg lh-lg o-default-button"
                t-on-click="() => this.clickPartner(this.props.partner)"
            >
                Discard
            </button>
        </xpath>
    </t>
</templates>
