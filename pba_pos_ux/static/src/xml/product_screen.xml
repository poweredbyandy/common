<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//CategorySelector" position="before">
            <div
                t-if="!ui.isSmall || !pos.scanning"
                class="pba_pos_ux_section_title px-2 pt-2"
            >
                Categorías
            </div>
        </xpath>
        <xpath expr="//CameraBarcodeScanner" position="before">
            <div t-if="!pos.scanning" class="pba_pos_ux_products_header">
                <span class="pba_pos_ux_section_title">Productos</span>
                <div class="pba_pos_ux_product_view_toggle" role="group" aria-label="Vista de productos">
                    <button
                        type="button"
                        class="pba_pos_ux_view_btn"
                        t-att-class="{'active': (pos.productListView || 'grid') === 'grid'}"
                        t-att-disabled="pos.productListViewSwitching"
                        t-on-click.stop="() => pos.setProductListView('grid')"
                        title="Vista cards"
                        aria-label="Vista cards"
                    >
                        <i class="fa fa-th-large" aria-hidden="true"/>
                        <span>Cards</span>
                    </button>
                    <button
                        type="button"
                        class="pba_pos_ux_view_btn"
                        t-att-class="{'active': pos.productListView === 'list'}"
                        t-att-disabled="pos.productListViewSwitching"
                        t-on-click.stop="() => pos.setProductListView('list')"
                        title="Vista lista"
                        aria-label="Vista lista"
                    >
                        <i class="fa fa-list" aria-hidden="true"/>
                        <span>Lista</span>
                    </button>
                </div>
            </div>
        </xpath>
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="class">getProductCardClass(product)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-reminder')]" position="attributes">
            <attribute name="t-if">pos.get_order()?.get_selected_orderline() and pos.hasJustAddedProduct</attribute>
        </xpath>
        <xpath expr="//button[hasclass('pay-button')]" position="attributes">
            <attribute name="t-attf-class">{{ !pos.get_order() or currentOrder.is_empty() ? 'btn-secondary' : 'btn-primary' }}</attribute>
        </xpath>
    </t>
</templates>

