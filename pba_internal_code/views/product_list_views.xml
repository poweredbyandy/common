<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_internal_code" model="ir.ui.view">
        <field name="name">product.template.list.internal.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="internal_code" optional="show"/>
            </field>
        </field>
    </record>
    <record id="product_product_tree_view_internal_code" model="ir.ui.view">
        <field name="name">product.product.list.internal.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="internal_code" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
