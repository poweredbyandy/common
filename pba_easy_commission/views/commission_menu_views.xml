<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_tree_commission_inherit" model="ir.ui.view">
        <field name="name">account.invoice.tree.commission.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_open_commission_billing_wizard"
                        type="object"
                        string="Facturar Comisiones"
                        groups="pba_easy_commission.group_commission_user"/>
            </xpath>
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="commission_percent"
                       optional="show"
                       column_invisible="context.get('default_move_type') != 'out_invoice'"/>
                <field name="commission_state"
                       widget="badge"
                       optional="show"
                       column_invisible="context.get('default_move_type') != 'out_invoice'"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_customer_commissions" model="ir.ui.view">
        <field name="name">account.move.tree.customer.commissions</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Comisiones de Clientes" default_order="invoice_date desc">
                <header>
                    <button name="action_open_commission_billing_wizard"
                            type="object"
                            string="Facturar Comisiones"
                            groups="pba_easy_commission.group_commission_user"/>
                </header>
                <field name="name" string="Factura"/>
                <field name="invoice_date" string="Fecha Factura"/>
                <field name="partner_id" string="Cliente"/>
                <field name="invoice_user_id" string="Vendedor" widget="many2one_avatar_user"/>
                <field name="commission_percent" string="% Comision"/>
                <field name="commission_state" string="Estado Comision" widget="badge"/>
                <field name="commission_amount_total" string="Monto Comision"/>
                <field name="amount_untaxed_in_currency_signed" string="Base Imponible" sum="Total"/>
                <field name="amount_tax_signed" string="Impuestos" sum="Total"/>
                <field name="amount_residual_signed" string="Saldo" sum="Saldo"/>
                <field name="currency_id"/>
                <field name="payment_state" string="Estado Pago"/>
            </list>
        </field>
    </record>

    <record id="view_move_search_customer_commissions" model="ir.ui.view">
        <field name="name">account.move.search.customer.commissions</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Comisiones">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_user_id"/>
                <filter string="Disponible para comisionar"
                        name="filter_commission_available"
                        domain="[('commission_available', '=', True)]"/>
                <separator/>
                <filter string="Vendedor"
                        name="group_by_invoice_user"
                        context="{'group_by': 'invoice_user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_customer_commissions" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pba_easy_commission.view_move_tree_customer_commissions"/>
        <field name="search_view_id" ref="pba_easy_commission.view_move_search_customer_commissions"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('paid', 'partial', 'in_payment'))]</field>
        <field name="context">{
            'default_move_type': 'out_invoice',
            'search_default_filter_commission_available': 1,
            'search_default_group_by_invoice_user': 1,
        }</field>
    </record>

    <record id="view_move_tree_vendor_commissions" model="ir.ui.view">
        <field name="name">account.move.tree.vendor.commissions</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Facturas de Comisiones a Vendedores" default_order="invoice_date desc">
                <field name="name" string="Factura Proveedor"/>
                <field name="state"/>
                <field name="invoice_date" string="Fecha"/>
                <field name="partner_id" string="Vendedor"/>
                <field name="commission_source_invoice_id" string="Factura Origen"/>
                <field name="amount_untaxed_in_currency_signed" string="Base" sum="Total"/>
                <field name="amount_tax_signed" string="Impuestos" sum="Total"/>
                <field name="amount_total_in_currency_signed" string="Total" sum="Total"/>
                <field name="amount_residual_signed" string="Saldo" sum="Saldo"/>
                <field name="currency_id"/>
                <field name="payment_state" string="Estado Pago"/>
            </list>
        </field>
    </record>

    <record id="action_vendor_commissions" model="ir.actions.act_window">
        <field name="name">Comisiones</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="pba_easy_commission.view_move_tree_vendor_commissions"/>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('is_commission_vendor_bill', '=', True)]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
    </record>

</odoo>
