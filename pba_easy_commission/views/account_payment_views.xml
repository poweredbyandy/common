<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_pba_commission" model="ir.ui.view">
        <field name="name">account.payment.form.pba.commission</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field
                    name="pba_apply_commission"
                    readonly="state != 'draft'"
                    invisible="payment_type != 'inbound' or partner_type != 'customer'"
                />
            </xpath>
        </field>
    </record>
</odoo>
