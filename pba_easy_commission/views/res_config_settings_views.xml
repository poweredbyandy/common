<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_commission" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.commission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Comisiones">
                    <setting id="commission_product_setting" help="Producto usado para facturas de proveedor de comision.">
                        <field name="commission_product_id"/>
                    </setting>
                    <setting id="commission_excluded_journals_setting" help="Pagos en estos diarios no se tomaran en cuenta para calcular comisiones.">
                        <field name="commission_excluded_journal_ids" widget="many2many_tags"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
