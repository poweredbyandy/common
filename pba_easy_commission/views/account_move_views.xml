<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_commission_inherit" model="ir.ui.view">
        <field name="name">account.move.form.commission.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="is_commission_vendor_bill" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_refresh_commission_lines"
                        string="Actualizar Comision"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type != 'out_invoice'"
                        groups="pba_easy_commission.group_commission_user"/>
                <button name="action_open_commission_billing_wizard"
                        string="Facturar Comision"
                        type="object"
                        class="btn-primary"
                        invisible="move_type != 'out_invoice'"
                        groups="pba_easy_commission.group_commission_user"/>
                <button name="action_print_commission_payment_voucher"
                        string="Comprobante de Comisiones"
                        type="object"
                        class="btn-secondary"
                        invisible="not is_commission_vendor_bill"
                        groups="pba_easy_commission.group_commission_user"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_open_commission_vendor_bills"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="move_type != 'out_invoice' or commission_vendor_bill_count == 0"
                        groups="pba_easy_commission.group_commission_user">
                    <field name="commission_vendor_bill_count" widget="statinfo" string="Ver comisiones"/>
                </button>
            </xpath>

            <xpath expr="//page[@id='other_tab']//group[@name='sale_info_group']/field[@name='ref']" position="after">
                <field name="commission_percent" invisible="move_type != 'out_invoice'" groups="pba_easy_commission.group_commission_admin"/>
                <field name="commission_percent" invisible="move_type != 'out_invoice'" groups="pba_easy_commission.group_commission_user" readonly="1"/>
                <field name="commission_state" invisible="move_type != 'out_invoice'" readonly="1" widget="statusbar" statusbar_visible="waiting,invoiced,paid"/>
                <field name="commission_amount_total" invisible="move_type != 'out_invoice'" readonly="1"/>
                <field name="commission_amount_pending" invisible="move_type != 'out_invoice'" readonly="1"/>
            </xpath>

            <xpath expr="//page[@name='other_info']" position="after">
                <page string="Comisiones" invisible="move_type != 'out_invoice'" groups="pba_easy_commission.group_commission_user">
                    <div class="mb-2">
                        <button name="action_open_commission_adjustment_wizard"
                                string="Ajuste manual de comision"
                                type="object"
                                class="btn-secondary"
                                invisible="state != 'posted'"
                                groups="pba_easy_commission.group_commission_user"/>
                    </div>
                    <field name="commission_line_ids" readonly="1">
                        <list>
                            <field name="payment_id" optional="show"/>
                            <field name="credit_note_move_id" optional="show"/>
                            <field name="payment_move_id"/>
                            <field name="currency_id"/>
                            <field name="payment_amount"/>
                            <field name="invoice_commission_percent" optional="show"/>
                            <field name="commission_percent"/>
                            <field name="commission_amount"/>
                            <field name="state" widget="badge"/>
                            <field name="is_legacy_commission" optional="hide"/>
                            <field name="vendor_bill_id"/>
                            <field name="description"/>
                        </list>
                    </field>
                    <separator string="Ajustes manuales"/>
                    <field name="commission_adjustment_ids" readonly="1">
                        <list>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="description"/>
                            <field name="note" optional="show"/>
                            <field name="state" widget="badge"/>
                            <field name="vendor_bill_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
