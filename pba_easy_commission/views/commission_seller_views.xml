<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_seller_tree" model="ir.ui.view">
        <field name="name">res.users.commission.seller.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Vendedores" editable="bottom" default_order="name" open_form_view="1">
                <field name="partner_id" column_invisible="True"/>
                <button name="action_open_seller_partner"
                        type="object"
                        icon="fa-external-link"
                        string="Abrir"
                        title="Abrir contacto del vendedor"
                        groups="pba_easy_commission.group_commission_user"/>
                <field name="name" string="Vendedor"/>
                <field name="login" optional="hide"/>
                <field name="commission_percent" string="% Comision"
                       groups="pba_easy_commission.group_commission_admin"/>
                <field name="commission_percent" string="% Comision"
                       readonly="1"
                       groups="pba_easy_commission.group_commission_user,!pba_easy_commission.group_commission_admin"/>
                <field name="commission_pending_invoice_count" string="Fact. Pendientes"/>
                <field name="commission_pending_display" string="Total Pendiente"/>
                <button name="action_refresh_seller_commissions"
                        type="object"
                        icon="fa-refresh"
                        title="Actualizar Comision"
                        groups="pba_easy_commission.group_commission_user"/>
                <button name="action_open_pending_commissions"
                        type="object"
                        icon="fa-list"
                        title="Ver Pendientes"
                        groups="pba_easy_commission.group_commission_user"/>
                <button name="action_pay_pending_commissions"
                        type="object"
                        icon="fa-money"
                        title="Pagar Comisiones"
                        groups="pba_easy_commission.group_commission_user"
                        invisible="commission_pending_invoice_count == 0"/>
                <button name="action_print_pending_commissions"
                        type="object"
                        icon="fa-print"
                        title="Comisiones Pendientes PDF"
                        groups="pba_easy_commission.group_commission_user"
                        invisible="commission_pending_invoice_count == 0"/>
            </list>
        </field>
    </record>

    <record id="view_commission_seller_form" model="ir.ui.view">
        <field name="name">res.users.commission.seller.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Vendedor">
                <field name="partner_id" invisible="1"/>
                <header>
                    <button name="action_open_seller_partner"
                            string="Abrir Contacto"
                            type="object"
                            class="btn-primary"
                            groups="pba_easy_commission.group_commission_user"/>
                    <button name="action_print_pending_commissions"
                            string="Comisiones Pendientes"
                            type="object"
                            class="btn-secondary"
                            groups="pba_easy_commission.group_commission_user"
                            invisible="commission_pending_invoice_count == 0"/>
                    <button name="action_pay_pending_commissions"
                            string="Pagar Comisiones"
                            type="object"
                            class="btn-primary"
                            groups="pba_easy_commission.group_commission_user"
                            invisible="commission_pending_invoice_count == 0"/>
                    <button name="action_refresh_seller_commissions"
                            string="Actualizar Comision"
                            type="object"
                            class="btn-secondary"
                            groups="pba_easy_commission.group_commission_user"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted"><field name="login" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Comision">
                            <field name="commission_percent"
                                   groups="pba_easy_commission.group_commission_admin"/>
                            <field name="commission_percent"
                                   readonly="1"
                                   groups="pba_easy_commission.group_commission_user,!pba_easy_commission.group_commission_admin"/>
                            <field name="commission_billing_periodicity"
                                   groups="pba_easy_commission.group_commission_admin"/>
                            <field name="commission_billing_periodicity"
                                   readonly="1"
                                   groups="pba_easy_commission.group_commission_user,!pba_easy_commission.group_commission_admin"/>
                            <field name="commission_billing_day"
                                   invisible="commission_billing_periodicity != 'monthly'"
                                   groups="pba_easy_commission.group_commission_admin"/>
                            <field name="commission_billing_day"
                                   invisible="commission_billing_periodicity != 'monthly'"
                                   readonly="1"
                                   groups="pba_easy_commission.group_commission_user,!pba_easy_commission.group_commission_admin"/>
                        </group>
                        <group string="Pendiente por facturar">
                            <field name="commission_pending_invoice_count" readonly="1"/>
                            <field name="commission_pending_display" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commission_seller_search" model="ir.ui.view">
        <field name="name">res.users.commission.seller.search</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search string="Vendedores">
                <field name="name"/>
                <field name="login"/>
                <filter string="Con comision pendiente"
                        name="filter_with_pending"
                        domain="[('commission_pending_invoice_count', '&gt;', 0)]"/>
                <filter string="Activos" name="filter_active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_commission_sellers" model="ir.actions.act_window">
        <field name="name">Vendedores</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('pba_easy_commission.view_commission_seller_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('pba_easy_commission.view_commission_seller_form')}),
        ]"/>
        <field name="search_view_id" ref="pba_easy_commission.view_commission_seller_search"/>
        <field name="domain">[('share', '=', False), ('active', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <menuitem id="menu_commission_root"
              name="Comisiones"
              sequence="45"
              groups="pba_easy_commission.group_commission_user"/>

    <menuitem id="menu_commission_sellers"
              name="Vendedores"
              parent="pba_easy_commission.menu_commission_root"
              action="pba_easy_commission.action_commission_sellers"
              sequence="10"/>

    <menuitem id="menu_customer_commissions"
              name="Facturas por Comisionar"
              parent="pba_easy_commission.menu_commission_root"
              action="pba_easy_commission.action_customer_commissions"
              sequence="20"
              groups="pba_easy_commission.group_commission_user"/>

    <menuitem id="menu_vendor_commissions"
              name="Comisiones Facturadas"
              parent="pba_easy_commission.menu_commission_root"
              action="pba_easy_commission.action_vendor_commissions"
              sequence="30"
              groups="pba_easy_commission.group_commission_user"/>
</odoo>
