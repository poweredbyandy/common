<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_adjustment_wizard_form" model="ir.ui.view">
        <field name="name">commission.adjustment.wizard.form</field>
        <field name="model">commission.adjustment.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajuste manual de comision">
                <group>
                    <field name="invoice_id"/>
                    <field name="currency_id"/>
                    <field name="amount"/>
                    <field name="note" placeholder="Motivo del ajuste (opcional)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar ajuste" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
