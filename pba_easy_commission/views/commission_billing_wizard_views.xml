<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_billing_wizard_form" model="ir.ui.view">
        <field name="name">commission.billing.wizard.form</field>
        <field name="model">commission.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar Comisiones">
                <group>
                    <field name="invoice_ids" widget="many2many_tags" readonly="1"/>
                    <field name="mode"/>
                    <field name="currency_id" invisible="mode == 'standard'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Crear Facturas" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
