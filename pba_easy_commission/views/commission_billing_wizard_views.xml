<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_billing_wizard_form" model="ir.ui.view">
        <field name="name">commission.billing.wizard.form</field>
        <field name="model">commission.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Pagar Comisiones">
                <field name="partner_id" invisible="1"/>
                <field name="invoice_ids" invisible="1"/>
                <sheet>
                    <field name="summary_html" nolabel="1" class="mb-2"/>
                    <group class="mt-1">
                        <group string="Opciones de facturacion">
                            <field name="mode" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Facturar Comisiones" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
