<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_billing_wizard_form" model="ir.ui.view">
        <field name="name">commission.billing.wizard.form</field>
        <field name="model">commission.billing.wizard</field>
        <field name="arch" type="xml">
            <form string="Pagar Comisiones">
                <field name="partner_id" invisible="1"/>
                <field name="invoice_ids" invisible="1"/>
                <sheet>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" decoration-muted="not selected">
                            <field name="selected" widget="boolean_toggle" string="Facturar" force_save="1"/>
                            <field name="invoice_name" string="Factura"/>
                            <field name="partner_id" string="Cliente"/>
                            <field name="sale_amount" string="Monto venta"/>
                            <field name="commission_percent" string="%"/>
                            <field name="description" string="Detalle"/>
                            <field name="commission_amount" string="Comisión"/>
                            <field name="currency_id" string="Moneda"/>
                            <field name="commission_line_id" column_invisible="1" force_save="1"/>
                            <field name="invoice_id" column_invisible="1"/>
                            <field name="invoice_date" column_invisible="1"/>
                            <field name="sale_currency_id" column_invisible="1"/>
                            <field name="payment_amount" column_invisible="1"/>
                        </list>
                    </field>
                    <group class="mt-1">
                        <group>
                            <field name="total_summary" readonly="1"/>
                        </group>
                        <group string="Opciones de facturacion">
                            <field name="mode" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_select_all" type="object" string="Seleccionar todo" class="btn-secondary"/>
                    <button name="action_deselect_all" type="object" string="Deseleccionar todo" class="btn-secondary"/>
                    <button name="action_confirm" type="object" string="Facturar Comisiones" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
