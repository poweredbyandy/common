<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_hide_line_discount" model="ir.ui.view">
        <field name="name">sale.order.form.hide.line.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//t[label[@for='discount']]" position="replace"/>
            <xpath expr="//field[@name='order_line']/kanban/templates//main/t[div/field[@name='discount']]" position="replace"/>
        </field>
    </record>

    <record id="sale_order_line_view_form_readonly_hide_discount" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.hide.discount</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <field name="discount" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="account_move_view_form_hide_customer_line_discount" model="ir.ui.view">
        <field name="name">account.move.form.hide.customer.line.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='discount']" position="attributes">
                <attribute name="invisible">parent.move_type in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>
        </field>
    </record>

</odoo>
