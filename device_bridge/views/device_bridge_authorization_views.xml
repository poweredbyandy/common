<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="device_bridge_authorization_view_list" model="ir.ui.view">
        <field name="name">device.bridge.authorization.view.list</field>
        <field name="model">device.bridge.authorization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_id"/>
                <field name="user_id"/>
                <field name="connection_type"/>
                <field name="product_name"/>
                <field name="vendor_id"/>
                <field name="product_id"/>
                <field name="last_used"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="device_bridge_authorization_view_form" model="ir.ui.view">
        <field name="name">device.bridge.authorization.view.form</field>
        <field name="model">device.bridge.authorization</field>
        <field name="arch" type="xml">
            <form string="Authorization">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="user_id"/>
                            <field name="connection_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="browser_key"/>
                            <field name="vendor_id"/>
                            <field name="product_id"/>
                            <field name="serial_number"/>
                            <field name="product_name"/>
                            <field name="manufacturer_name"/>
                            <field name="last_used"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_bridge_authorization_action" model="ir.actions.act_window">
        <field name="name">Authorizations</field>
        <field name="res_model">device.bridge.authorization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
