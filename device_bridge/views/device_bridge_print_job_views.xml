<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="device_bridge_print_job_view_list" model="ir.ui.view">
        <field name="name">device.bridge.print.job.view.list</field>
        <field name="model">device.bridge.print.job</field>
        <field name="arch" type="xml">
            <list create="0" delete="1">
                <field name="create_date"/>
                <field name="name"/>
                <field name="device_id"/>
                <field name="gateway_id"/>
                <field name="requester_id"/>
                <field
                    name="state"
                    decoration-info="state == 'pending'"
                    decoration-warning="state == 'processing'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'error'"
                    widget="badge"
                />
                <field name="error_message" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="device_bridge_print_job_view_form" model="ir.ui.view">
        <field name="name">device.bridge.print.job.view.form</field>
        <field name="model">device.bridge.print.job</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" string="Print job">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="gateway_id"/>
                            <field name="requester_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="error_message"/>
                            <field name="create_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_bridge_print_job_view_search" model="ir.ui.view">
        <field name="name">device.bridge.print.job.view.search</field>
        <field name="model">device.bridge.print.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="device_id"/>
                <field name="gateway_id"/>
                <field name="requester_id"/>
                <filter
                    name="filter_queued"
                    string="Queued"
                    domain="[('state', 'in', ('pending', 'processing'))]"
                />
                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="filter_processing"
                    string="Processing"
                    domain="[('state', '=', 'processing')]"
                />
                <filter
                    name="filter_done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <filter
                    name="filter_error"
                    string="Error"
                    domain="[('state', '=', 'error')]"
                />
                <separator/>
                <filter
                    name="group_device"
                    string="Device"
                    context="{'group_by': 'device_id'}"
                />
                <filter
                    name="group_state"
                    string="Status"
                    context="{'group_by': 'state'}"
                />
                <filter
                    name="group_company"
                    string="Company"
                    context="{'group_by': 'company_id'}"
                    groups="base.group_multi_company"
                />
            </search>
        </field>
    </record>

    <record id="device_bridge_print_job_action" model="ir.actions.act_window">
        <field name="name">Print queue</field>
        <field name="res_model">device.bridge.print.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_queued': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No queued print jobs
            </p>
            <p>
                Jobs stay here when a gateway is offline or a print did not
                finish. Select them and delete them to clear the queue.
            </p>
        </field>
    </record>
</odoo>
