<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="device_bridge_action_register" model="ir.actions.client">
        <field name="name">Register device</field>
        <field name="tag">device_bridge_register</field>
        <field name="target">new</field>
    </record>

    <record id="device_bridge_view_list" model="ir.ui.view">
        <field name="name">device.bridge.view.list</field>
        <field name="model">device.bridge</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="%(device_bridge_action_register)d"
                        type="action"
                        string="Register device"
                        display="always"
                        class="btn-primary"
                    />
                </header>
                <field name="name"/>
                <field name="code"/>
                <field name="device_type"/>
                <field name="protocol"/>
                <field name="connection_types"/>
                <field name="vendor_ids"/>
                <field name="product_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="device_bridge_view_form" model="ir.ui.view">
        <field name="name">device.bridge.view.form</field>
        <field name="model">device.bridge</field>
        <field name="arch" type="xml">
            <form string="Device">
                <header>
                    <button
                        name="%(device_bridge_action_register)d"
                        type="action"
                        string="Register USB device"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Device name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="device_type"/>
                            <field name="protocol"/>
                            <field name="connection_types"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="vendor_ids"/>
                            <field name="product_ids"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Authorizations" name="authorizations">
                            <field name="authorization_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="connection_type"/>
                                    <field name="browser_key"/>
                                    <field name="last_used"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gateways" name="gateways">
                            <field name="gateway_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="device_label"/>
                                    <field name="last_seen"/>
                                    <field name="is_online"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="device_bridge_view_search" model="ir.ui.view">
        <field name="name">device.bridge.view.search</field>
        <field name="model">device.bridge</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="device_type"/>
                <filter string="Printers" name="printers" domain="[('device_type', 'in', ('printer', 'label_printer'))]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Device type" name="group_device_type" context="{'group_by': 'device_type'}"/>
                    <filter string="Protocol" name="group_protocol" context="{'group_by': 'protocol'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="device_bridge_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">device.bridge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
