<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_device_bridge" model="ir.module.category">
        <field name="name">Device Bridge</field>
        <field name="sequence">55</field>
    </record>

    <record id="group_device_bridge_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_device_bridge"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_device_bridge_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_device_bridge"/>
        <field name="implied_ids" eval="[(4, ref('group_device_bridge_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="device_bridge_authorization_rule_user" model="ir.rule">
        <field name="name">Device Bridge Authorization: own records</field>
        <field name="model_id" ref="model_device_bridge_authorization"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="device_bridge_authorization_rule_manager" model="ir.rule">
        <field name="name">Device Bridge Authorization: manager all</field>
        <field name="model_id" ref="model_device_bridge_authorization"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_device_bridge_manager'))]"/>
    </record>

    <record id="device_bridge_gateway_rule_user" model="ir.rule">
        <field name="name">Device Bridge Gateway: own records</field>
        <field name="model_id" ref="model_device_bridge_gateway"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="device_bridge_gateway_rule_manager" model="ir.rule">
        <field name="name">Device Bridge Gateway: manager all</field>
        <field name="model_id" ref="model_device_bridge_gateway"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_device_bridge_manager'))]"/>
    </record>
</odoo>
