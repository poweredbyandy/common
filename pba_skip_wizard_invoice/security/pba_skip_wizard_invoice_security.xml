<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_sale_confirm_invoice" model="ir.module.category">
        <field name="name">Confirmar y crear factura</field>
        <field name="description">Controla el botón Confirmar y Crear Factura en pedidos de venta.</field>
        <field name="sequence">27</field>
    </record>

    <record id="group_sale_confirm_create_invoice" model="res.groups">
        <field name="name">Confirmar y crear factura</field>
        <field name="category_id" ref="module_category_pba_sale_confirm_invoice"/>
        <field name="comment">Muestra el botón Confirmar y Crear Factura. Por defecto se asigna a vendedores; se puede quitar por usuario.</field>
    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_sale_confirm_create_invoice'))]"/>
    </record>
</odoo>
