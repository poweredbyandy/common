<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_confirm_invoice_button" model="ir.ui.view">
        <field name="name">sale.order.form.confirm.create.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm'][last()]" position="after">
                <button
                    name="action_confirm_create_and_post_invoice"
                    type="object"
                    string="Confirmar y Crear Factura"
                    class="btn-secondary"
                    invisible="state not in ('draft', 'sent', 'sale') or (state == 'sale' and invoice_status == 'invoiced')"
                    groups="pba_skip_wizard_invoice.group_sale_confirm_create_invoice"
                />
            </xpath>
        </field>
    </record>
</odoo>
