<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_financial_risk_action" model="ir.ui.view">
        <field name="name">res.partner.form.financial.risk.action</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Riesgo financiero">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                    <group
                        string="Configuracion de riesgo"
                        invisible="not is_company and parent_id"
                        groups="account_financial_risk.group_account_financial_risk_user"
                        col="4"
                    >
                        <field name="risk_allow_edit" invisible="1"/>
                        <field name="risk_currency_id" readonly="1"/>
                        <field name="credit_currency" readonly="not risk_allow_edit"/>
                        <field name="manual_credit_currency_id" options="{'no_create': True}" readonly="not risk_allow_edit" invisible="credit_currency != 'manual'"/>
                        <field name="credit_limit" widget="monetary" options="{'currency_field': 'risk_currency_id'}" readonly="not risk_allow_edit"/>
                        <field name="date_credit_limit" readonly="not risk_allow_edit"/>
                        <field name="credit_policy" readonly="not risk_allow_edit"/>
                        <field name="pba_block_sale_on_overdue_all" readonly="not risk_allow_edit"/>
                        <field name="pba_block_sale_on_overdue_credit" readonly="not risk_allow_edit"/>
                        <field name="risk_exception" readonly="1"/>
                        <field name="risk_amount_exceeded" widget="monetary" options="{'currency_field': 'risk_currency_id'}" readonly="1"/>
                        <field name="show_financial_risk_in_portal" invisible="not portal_show_financial_risk_visible"/>
                        <field name="portal_show_financial_risk_visible" invisible="1"/>
                    </group>
                    <group
                        invisible="not is_company and parent_id"
                        groups="account_financial_risk.group_account_financial_risk_user"
                    >
                        <field name="risk_dashboard_json" widget="risk_dashboard" nolabel="1" readonly="1"/>
                        <field name="risk_invoice_draft_include" invisible="1"/>
                        <field name="risk_invoice_open_include" invisible="1"/>
                        <field name="risk_invoice_unpaid_include" invisible="1"/>
                        <field name="risk_account_amount_include" invisible="1"/>
                        <field name="risk_account_amount_unpaid_include" invisible="1"/>
                        <field name="risk_sale_order_include" invisible="1"/>
                        <field name="risk_invoice_draft_limit" invisible="1"/>
                        <field name="risk_invoice_open_limit" invisible="1"/>
                        <field name="risk_invoice_unpaid_limit" invisible="1"/>
                        <field name="risk_account_amount_limit" invisible="1"/>
                        <field name="risk_account_amount_unpaid_limit" invisible="1"/>
                        <field name="risk_sale_order_limit" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_partner_form_financial_risk_overdue_block" model="ir.ui.view">
        <field name="name">res.partner.form.financial.risk.overdue.block</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_financial_risk.res_partner_view_risk"/>
        <field name="arch" type="xml">
            <group name="risk_general" position="inside">
                <group
                    string="Bloqueo por facturas vencidas"
                    col="2"
                    groups="account_financial_risk.group_account_financial_risk_user"
                >
                    <field name="risk_allow_edit" invisible="1"/>
                    <field
                        name="pba_block_sale_on_overdue_all"
                        readonly="not risk_allow_edit"
                    />
                    <field
                        name="pba_block_sale_on_overdue_credit"
                        readonly="not risk_allow_edit"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
