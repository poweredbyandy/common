<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_item_discount_wizard_view_form" model="ir.ui.view">
        <field name="name">product.pricelist.item.discount.wizard.form</field>
        <field name="model">product.pricelist.item.discount.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Discount">
                <group>
                    <field name="discount"/>
                    <field name="item_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button
                        name="action_apply_discount"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_pricelist_item_discount_wizard_action" model="ir.actions.act_window">
        <field name="name">Update Discount (%)</field>
        <field name="res_model">product.pricelist.item.discount.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_pricelist_item"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
