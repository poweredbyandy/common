<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_credit_authorization" model="ir.ui.view">
        <field name="name">account.move.form.credit.authorization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="is_credit_sale" invisible="1"/>
                <field name="can_authorize_credit" invisible="1"/>
                <label for="credit_authorized"
                       invisible="not is_credit_sale or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                <field name="credit_authorized"
                nolabel="1"
                       invisible="not is_credit_sale or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                       readonly="not can_authorize_credit"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

</odoo>
