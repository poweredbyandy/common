<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla compartida: recibe company, partner y bultos -->
    <template id="envelope_document">
        <!-- El div "article" es obligatorio: Odoo solo envuelve el contenido con
             web.minimal_layout (que declara <meta charset="utf-8"/>) si lo encuentra.
             Sin él, wkhtmltopdf adivina la codificación y los acentos salen mal. -->
        <div class="article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
        <div class="page" style="position:relative; width:21.59cm; height:27.9cm;
                                overflow:hidden;">
            <!-- Área del sobre: 10 x 23 cm, centrada en horizontal y pegada
                 al borde superior de la hoja carta
                 left = (21.59 - 10) / 2 = 5.795cm ; top = 0 -->
            <div style="position:absolute; left:5.795cm; top:0;
                        width:10cm; height:23cm;">
                <!-- Contenido horizontal (23 x 10) rotado 90° -->
                <div style="position:absolute; left:10cm; top:0.5cm;
                            width:23cm; height:10cm;
                            -webkit-transform-origin:0 0;
                            -webkit-transform:rotate(90deg);
                            font-family:Arial, Helvetica, sans-serif; color:#000;">

                    <!-- ===== Parte superior: logo + datos del CLIENTE ===== -->
                    <div style="height:7.2cm; box-sizing:border-box; padding:0.3cm 0.4cm;
                                border-bottom:1.5px solid #000;">
                        <!-- Logo -->
                        <div style="height:2.2cm;">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="max-width:8cm; max-height:2.2cm;"/>
                        </div>
                        <!-- Datos del cliente (debajo del logo) -->
                        <!-- Nombre: alto fijo de 2 líneas (16pt x 18pt de interlineado = 36pt) -->
                        <div style="font-size:16pt; line-height:18pt; height:36pt; overflow:hidden;
                                    font-weight:bold; text-transform:uppercase;
                                    margin-top:0.15cm; margin-bottom:0.1cm;
                                    font-family:'Times New Roman';"
                             t-out="partner.name"/>
                        <div style="font-size:10pt; margin-top:0.1cm; font-family:'Courier New'; font-weight:bold;"
                             t-out="partner.vat"/>
                        <div style="font-size:12pt; text-transform:uppercase; margin-top:0.1cm; font-family:'Times New Roman';"
                             t-out="partner._display_address(without_company=True)"/>
                        <div style="font-size:12pt; margin-top:0.1cm; margin-left:2.5cm; font-family:'Times New Roman'; font-weight:bold;">
                            Teléfono: <t t-out="partner._envelope_phone()"/>
                        </div>
                        <!-- Bultos: línea siguiente al teléfono, alineado a la derecha -->
                        <div style="text-align:right; font-family:'Times New Roman', serif;
                                    font-size:14pt; font-weight:bold;">
                            <t t-out="bultos or 1"/>-Bulto<t t-if="(bultos or 1) != 1">s</t>
                        </div>
                    </div>

                    <!-- ===== Parte inferior: datos de la COMPAÑÍA (centrados) ===== -->
                    <div style="height:2.8cm; box-sizing:border-box; padding:0 0.4cm;
                                text-align:center;">
                        <div style="font-size:11pt; margin-top:0; font-style:italic;"
                             t-out="company.partner_id._display_address(without_company=True)"/>
                        <div style="font-size:11pt; margin-top:0.1cm; font-weight:bold; font-style:italic;">
                            Teléfono: <t t-out="company.partner_id._envelope_phone()"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </template>

    <!-- Sale Order -->
    <template id="report_envelope_sale_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pba_envelope_report.envelope_document">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="partner" t-value="o.partner_shipping_id or o.partner_id"/>
                    <t t-set="bultos" t-value="o._envelope_bultos()"/>
                </t>
            </t>
        </t>
    </template>

    <!-- Stock Picking -->
    <template id="report_envelope_stock_picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pba_envelope_report.envelope_document">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="partner" t-value="o.partner_id"/>
                    <t t-set="bultos" t-value="o._envelope_bultos()"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_envelope_sale_order" model="ir.actions.report">
        <field name="name">Sobre</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pba_envelope_report.report_envelope_sale_order</field>
        <field name="report_file">pba_envelope_report.report_envelope_sale_order</field>
        <field name="print_report_name">'Sobre_%s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_envelope_letter"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_envelope_stock_picking" model="ir.actions.report">
        <field name="name">Sobre</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pba_envelope_report.report_envelope_stock_picking</field>
        <field name="report_file">pba_envelope_report.report_envelope_stock_picking</field>
        <field name="print_report_name">'Sobre_%s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_envelope_letter"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
