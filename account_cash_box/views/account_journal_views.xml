<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_view_form" model="ir.ui.view">
        <field name="name">account.journal.form.cash.box</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_cash_box"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-money"
                    invisible="type != 'cash'"
                    groups="account_cash_box.group_cash_box_user"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cash Box</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
