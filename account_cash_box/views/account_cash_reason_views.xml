<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_cash_reason_view_search" model="ir.ui.view">
        <field name="name">account.cash.reason.search</field>
        <field name="model">account.cash.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_id"/>
                <filter name="in" string="Cash In" domain="[('move_type', '=', 'in')]"/>
                <filter name="out" string="Cash Out" domain="[('move_type', '=', 'out')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'move_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_cash_reason_view_list" model="ir.ui.view">
        <field name="name">account.cash.reason.list</field>
        <field name="model">account.cash.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="move_type"/>
                <field name="account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="account_cash_reason_view_form" model="ir.ui.view">
        <field name="name">account.cash.reason.form</field>
        <field name="model">account.cash.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="move_type"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_cash_reason_action" model="ir.actions.act_window">
        <field name="name">Cash Reasons</field>
        <field name="res_model">account.cash.reason</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
