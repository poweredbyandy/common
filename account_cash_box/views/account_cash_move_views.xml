<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_cash_move_view_search" model="ir.ui.view">
        <field name="name">account.cash.move.search</field>
        <field name="model">account.cash.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <field name="box_id"/>
                <field name="reason_id"/>
                <field name="partner_id"/>
                <filter name="in" string="Cash In" domain="[('move_type', '=', 'in')]"/>
                <filter name="out" string="Cash Out" domain="[('move_type', '=', 'out')]"/>
                <filter name="difference" string="Difference" domain="[('move_type', '=', 'difference')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'move_type'}"/>
                    <filter name="group_box" string="Cash Box" context="{'group_by': 'box_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="account_cash_move_view_list" model="ir.ui.view">
        <field name="name">account.cash.move.list</field>
        <field name="model">account.cash.move</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date"/>
                <field name="session_id"/>
                <field name="box_id"/>
                <field name="move_type"/>
                <field name="reason_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="signed_amount"/>
                <field name="user_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="account_cash_move_view_form" model="ir.ui.view">
        <field name="name">account.cash.move.form</field>
        <field name="model">account.cash.move</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button
                        name="action_open_journal_entry"
                        type="object"
                        string="Journal Entry"
                        invisible="not move_id"
                        groups="account.group_account_readonly"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="box_id"/>
                            <field name="move_type"/>
                            <field name="reason_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="signed_amount"/>
                            <field name="user_id"/>
                            <field name="move_id" groups="account.group_account_readonly"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_cash_move_action" model="ir.actions.act_window">
        <field name="name">Cash Moves</field>
        <field name="res_model">account.cash.move</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
