<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="account_cash_box.CashBoxOpenDialog">
    <Dialog size="'md'" title.translate="Open Cash Box">
        <div class="o_account_cash_box_dialog">
            <div class="mb-3">
                <div class="fw-bold" t-esc="props.box.name"/>
                <div class="text-muted small" t-esc="props.box.journal_name"/>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span>Accounting balance</span>
                <strong t-esc="formatAmount(props.box.accounting_balance)"/>
            </div>
            <div class="mt-3">
                <label class="form-label" for="cash_box_open_counted">Counted cash</label>
                <input
                    id="cash_box_open_counted"
                    type="number"
                    step="0.01"
                    class="form-control"
                    t-model.number="state.counted"
                />
            </div>
            <div class="d-flex justify-content-between py-2">
                <span>Difference</span>
                <strong t-att-class="difference ? 'text-warning' : 'text-muted'" t-esc="formatAmount(difference)"/>
            </div>
            <div class="mt-2">
                <label class="form-label" for="cash_box_open_notes">Notes</label>
                <textarea id="cash_box_open_notes" class="form-control" rows="2" t-model="state.notes"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="state.busy">Open</button>
            <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

<t t-name="account_cash_box.CashBoxMoveDialog">
    <Dialog size="'md'" title="title">
        <div class="o_account_cash_box_dialog">
            <div class="mb-3">
                <div class="fw-bold" t-esc="props.box.name"/>
                <div class="text-muted small">
                    Balance <t t-esc="formatAmount(props.box.accounting_balance)"/>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="cash_box_move_reason">Reason</label>
                <select id="cash_box_move_reason" class="form-select" t-model.number="state.reasonId">
                    <option t-foreach="filteredReasons" t-as="reason" t-key="reason.id" t-att-value="reason.id" t-esc="reason.name"/>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" for="cash_box_move_amount">Amount</label>
                <input
                    id="cash_box_move_amount"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-control"
                    t-model.number="state.amount"
                />
            </div>
            <div>
                <label class="form-label" for="cash_box_move_notes">Notes</label>
                <input id="cash_box_move_notes" class="form-control" t-model="state.notes"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="state.busy">Confirm</button>
            <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

<t t-name="account_cash_box.CashBoxCloseDialog">
    <Dialog size="'md'" title.translate="Close Cash Box">
        <div class="o_account_cash_box_dialog">
            <div class="mb-3">
                <div class="fw-bold" t-esc="props.box.name"/>
                <div class="text-muted small" t-esc="props.box.session_name"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Opening</span>
                <span t-esc="formatAmount(props.box.opening_balance)"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Cash in</span>
                <span class="text-success" t-esc="formatAmount(props.box.amount_in)"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Cash out</span>
                <span class="text-danger" t-esc="formatAmount(props.box.amount_out)"/>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span>Other journal items</span>
                <span t-esc="formatAmount(props.box.amount_other)"/>
            </div>
            <div class="d-flex justify-content-between py-2">
                <strong>Expected</strong>
                <strong t-esc="formatAmount(props.box.accounting_balance)"/>
            </div>
            <div class="mt-2">
                <label class="form-label" for="cash_box_close_counted">Counted cash</label>
                <input
                    id="cash_box_close_counted"
                    type="number"
                    step="0.01"
                    class="form-control"
                    t-model.number="state.counted"
                />
            </div>
            <div class="d-flex justify-content-between py-2">
                <span>Difference</span>
                <strong t-att-class="difference ? 'text-warning' : 'text-success'" t-esc="formatAmount(difference)"/>
            </div>
            <div class="mt-2">
                <label class="form-label" for="cash_box_close_notes">Notes</label>
                <textarea id="cash_box_close_notes" class="form-control" rows="2" t-model="state.notes"/>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="state.busy">Close</button>
            <button class="btn btn-secondary" t-on-click="() => props.close()">Cancel</button>
        </t>
    </Dialog>
</t>

<t t-name="account_cash_box.CashBoxStatusDialog">
    <Dialog size="'md'" title.translate="Cash Journal Status">
        <div class="o_account_cash_box_dialog">
            <div class="mb-3">
                <div class="fw-bold" t-esc="props.status.name"/>
                <div class="text-muted small" t-esc="props.status.journal_name"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Status</span>
                <span t-esc="props.status.state === 'open' ? 'Open' : 'Closed'"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Cash account</span>
                <span t-esc="props.status.cash_account"/>
            </div>
            <div class="d-flex justify-content-between py-1">
                <span>Accounting balance</span>
                <strong t-esc="formatAmount(props.status.accounting_balance)"/>
            </div>
            <t t-if="props.status.state === 'open'">
                <div class="d-flex justify-content-between py-1">
                    <span>Opening</span>
                    <span t-esc="formatAmount(props.status.opening_balance)"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Cash in</span>
                    <span t-esc="formatAmount(props.status.amount_in)"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Cash out</span>
                    <span t-esc="formatAmount(props.status.amount_out)"/>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span>Other journal items</span>
                    <span t-esc="formatAmount(props.status.amount_other)"/>
                </div>
            </t>
            <div t-if="props.status.moves.length" class="mt-3">
                <div class="fw-bold mb-2">Session moves</div>
                <div t-foreach="props.status.moves" t-as="move" t-key="move.id" class="d-flex justify-content-between small py-1 border-top">
                    <span>
                        <t t-esc="move.reason"/>
                    </span>
                    <span t-esc="formatAmount(move.signed_amount)"/>
                </div>
            </div>
        </div>
        <t t-set-slot="footer">
            <button t-if="props.status.session_id" class="btn btn-primary" t-on-click="() => { props.onOpenSession?.(); props.close(); }">Open session</button>
            <button class="btn btn-secondary" t-on-click="() => { props.onOpenJournal?.(); props.close(); }">Journal items</button>
            <button class="btn btn-secondary" t-on-click="() => props.close()">Close</button>
        </t>
    </Dialog>
</t>

</templates>
