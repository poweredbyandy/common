<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_cash_close_view_form" model="ir.ui.view">
        <field name="name">account.cash.close.form</field>
        <field name="model">account.cash.close</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="opening_balance"/>
                        <field name="amount_in"/>
                        <field name="amount_out"/>
                        <field name="amount_other"/>
                    </group>
                    <group>
                        <field name="expected_balance"/>
                        <field name="counted_balance"/>
                        <field name="difference"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="box_id" invisible="1"/>
                    </group>
                </group>
                <field name="notes" placeholder="Optional closing notes"/>
                <footer>
                    <button name="action_confirm" type="object" string="Close" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
