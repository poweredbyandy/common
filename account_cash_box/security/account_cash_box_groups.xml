<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cash_box" model="ir.module.category">
        <field name="name">Cash Box</field>
        <field name="parent_id" ref="base.module_category_accounting"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_cash_box_user" model="res.groups">
        <field name="name">Cashier</field>
        <field name="category_id" ref="module_category_cash_box"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can open a cash box, register cash in/out and close the daily session.</field>
    </record>

    <record id="group_cash_box_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_cash_box"/>
        <field name="implied_ids" eval="[(4, ref('group_cash_box_user')), (4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Can configure cash boxes and reasons, and review every session.</field>
    </record>
</odoo>
