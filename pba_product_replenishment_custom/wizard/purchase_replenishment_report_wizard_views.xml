<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pba_purchase_replenishment_report_wizard_form" model="ir.ui.view">
        <field name="name">pba.purchase.replenishment.report.wizard.form</field>
        <field name="model">pba.purchase.replenishment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Compras">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="category_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="brand_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="warehouse_id" options="{'no_create': True}"/>
                </group>
                <group string="Costos">
                    <field name="currency_id" options="{'no_create': True}"/>
                    <field
                        name="equivalence_currency_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        placeholder="Monedas adicionales de costo..."
                    />
                </group>
                <footer>
                    <button
                        name="action_download_report"
                        string="Descargar Excel"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pba_purchase_replenishment_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Compras</field>
        <field name="res_model">pba.purchase.replenishment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
