<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_product_replenishment" model="ir.module.category">
        <field name="name">PBA Reposición</field>
        <field name="description">Permisos del módulo PBA reporte de compras / reposición.</field>
        <field name="sequence">96</field>
    </record>
    <record id="group_pba_last_purchase_variant_list" model="res.groups">
        <field name="name">PBA: Ver última compra en lista de variantes</field>
        <field name="category_id" ref="module_category_pba_product_replenishment"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pba_last_purchase_variant_list'))]"/>
    </record>
</odoo>
