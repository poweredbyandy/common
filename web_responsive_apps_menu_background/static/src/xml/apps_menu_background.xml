<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="web_responsive.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('app-menu-container')]" position="attributes">
            <attribute
                name="t-attf-class"
            >app-menu-container{{ backgroundUrl ? ' o_apps_menu_has_custom_bg' : '' }}</attribute>
            <attribute name="t-att-style">backgroundStyle</attribute>
        </xpath>
    </t>
</templates>
