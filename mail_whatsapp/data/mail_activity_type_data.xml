<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_activity_type_whatsapp_followup" model="mail.activity.type">
        <field name="name">WhatsApp Follow-up</field>
        <field name="summary">WhatsApp follow-up</field>
        <field name="icon">fa-comments</field>
        <field name="delay_count">3</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">current_date</field>
        <field name="category">default</field>
        <field name="decoration_type">warning</field>
        <field name="is_whatsapp_followup" eval="True"/>
        <field name="default_note" type="html">
            <p>
                Follow-up WhatsApp: ask if they are still interested and offer
                updated information.
            </p>
        </field>
    </record>
</odoo>
