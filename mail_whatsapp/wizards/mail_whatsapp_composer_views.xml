<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_whatsapp_composer_view_form" model="ir.ui.view">
        <field name="name">mail.whatsapp.composer.view.form</field>
        <field name="model">mail.whatsapp.composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <field name="whatsapp_window_active" invisible="1" />
                <field name="whatsapp_window_info" invisible="1" />
                <div
                    class="alert alert-success mb-0"
                    role="alert"
                    invisible="not whatsapp_window_active"
                >
                    <i class="fa fa-check-circle"/>
                    <span>24-hour window is open. You can send a free-text message.</span>
                    <span invisible="not whatsapp_window_valid_until">
                        Valid until
                        <field
                            name="whatsapp_window_valid_until"
                            class="oe_inline"
                            nolabel="1"
                        />
                    </span>
                </div>
                <div
                    class="alert alert-warning mb-0"
                    role="alert"
                    invisible="whatsapp_window_active"
                >
                    <i class="fa fa-exclamation-triangle"/>
                    <span>
                        24-hour window is closed. Send an approved template
                        to contact the customer.
                    </span>
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="res_model" invisible="1" />
                            <field name="res_id" invisible="1" />
                            <field name="wa_account_id" />
                            <field name="phone" placeholder="+58..." />
                            <field
                                name="body"
                                placeholder="Write a free-text WhatsApp message..."
                                invisible="not whatsapp_window_active"
                                readonly="not whatsapp_window_active"
                            />
                            <field
                                name="wa_template_id"
                                options="{'no_create': True, 'no_open': True}"
                                placeholder="Select a WhatsApp template"
                                required="not whatsapp_window_active and not body"
                                invisible="whatsapp_window_active and body"
                            />
                        </group>
                        <group>
                            <field
                                name="preview"
                                nolabel="1"
                                colspan="2"
                                invisible="not preview"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_send_whatsapp_template"
                        type="object"
                        string="Send Message"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        data-hotkey="z"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
