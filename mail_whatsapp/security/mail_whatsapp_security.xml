<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_mail_whatsapp" model="ir.module.category">
        <field name="name">WhatsApp</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_mail_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_mail_whatsapp" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_mail_whatsapp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_mail_whatsapp" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_mail_whatsapp_user'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="mail_whatsapp_account_rule_company" model="ir.rule">
        <field name="name">WhatsApp Account multi-company</field>
        <field name="model_id" ref="model_mail_whatsapp_account" />
        <field name="domain_force">
            ['|', ('allowed_company_ids', '=', False), ('allowed_company_ids', 'in', company_ids)]
        </field>
    </record>
</odoo>
