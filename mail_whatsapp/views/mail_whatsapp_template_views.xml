<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mail_whatsapp_template_view_list" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.view.list</field>
        <field name="model">mail.whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="template_name" />
                <field name="wa_account_id" />
                <field name="model_id" optional="show" />
                <field name="lang_code" />
                <field name="category" />
                <field name="status" />
                <field name="active" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="mail_whatsapp_template_view_form" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.view.form</field>
        <field name="model">mail.whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <header>
                    <button
                        name="action_submit_to_meta"
                        type="object"
                        string="Submit to Meta"
                        class="btn-primary"
                        groups="mail_whatsapp.group_mail_whatsapp_admin"
                        invisible="status not in ('draft', 'REJECTED')"
                    />
                    <button
                        name="action_sync_from_meta"
                        type="object"
                        string="Sync from Meta"
                        groups="mail_whatsapp.group_mail_whatsapp_admin"
                    />
                    <field
                        name="status"
                        widget="statusbar"
                        statusbar_visible="draft,PENDING,APPROVED"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Order confirmation" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="wa_account_id" />
                            <field name="template_name" />
                            <field name="lang_code" />
                            <field name="category" />
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                        </group>
                        <group>
                            <field name="wa_template_uid" readonly="1" />
                            <field name="error_msg" readonly="1" />
                        </group>
                    </group>
                    <group string="Content">
                        <field name="header_type" />
                        <field
                            name="header_text"
                            invisible="header_type != 'TEXT'"
                            required="header_type == 'TEXT'"
                            placeholder="Optional header with {{1}}"
                        />
                        <field
                            name="body"
                            placeholder="Hola {{1}}, nos escribiste acerca de: {{2}}..."
                        />
                        <field name="footer_text" />
                    </group>
                    <group string="Dynamic Variables">
                        <field name="variable_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" string="#"/>
                                <field name="line_type"/>
                                <field name="name"/>
                                <field name="field_type"/>
                                <field
                                    name="field_name"
                                    invisible="field_type != 'field'"
                                    required="field_type == 'field'"
                                />
                                <field name="demo_value"/>
                            </list>
                        </field>
                    </group>
                    <group string="Buttons">
                        <field name="button_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="button_type"/>
                                <field name="url_type"/>
                                <field name="website_url"/>
                                <field
                                    name="demo_value"
                                    invisible="url_type != 'dynamic'"
                                    required="url_type == 'dynamic'"
                                />
                            </list>
                        </field>
                    </group>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="mail_whatsapp_template_view_search" model="ir.ui.view">
        <field name="name">mail.whatsapp.template.view.search</field>
        <field name="model">mail.whatsapp.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="template_name" />
                <field name="wa_account_id" />
                <filter
                    name="filter_approved"
                    string="Approved"
                    domain="[('status', '=', 'APPROVED')]"
                />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('status', '=', 'draft')]"
                />
                <group>
                    <filter
                        name="group_account"
                        string="Account"
                        context="{'group_by': 'wa_account_id'}"
                    />
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'status'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="mail_whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">mail.whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
