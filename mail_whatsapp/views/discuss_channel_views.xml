<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="discuss_channel_view_list_whatsapp" model="ir.ui.view">
        <field name="name">discuss.channel.view.list.whatsapp</field>
        <field name="model">discuss.channel</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list
                create="0"
                delete="0"
                action="action_whatsapp_open_chat"
                type="object"
                default_order="last_interest_dt desc"
            >
                <header>
                    <button
                        name="action_whatsapp_assign"
                        type="object"
                        string="Assign"
                        class="btn-primary"
                    />
                </header>
                <field name="name" string="Contact"/>
                <field name="whatsapp_number"/>
                <field name="whatsapp_company_id" string="Company" optional="show"/>
                <field name="wa_account_id" optional="show"/>
                <field name="whatsapp_user_id" string="Responsible" widget="many2one_avatar_user"/>
                <field
                    name="whatsapp_last_replier_partner_id"
                    string="Last Reply By"
                    optional="hide"
                />
                <field
                    name="whatsapp_tag_ids"
                    string="Tags"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="show"
                />
                <field name="last_interest_dt" string="Last Activity"/>
                <button
                    name="action_whatsapp_assign"
                    type="object"
                    string="Assign"
                    icon="fa-user-plus"
                />
            </list>
        </field>
    </record>

    <record id="discuss_channel_view_search_whatsapp" model="ir.ui.view">
        <field name="name">discuss.channel.view.search.whatsapp</field>
        <field name="model">discuss.channel</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Contact"/>
                <field name="whatsapp_number"/>
                <field name="whatsapp_user_id" string="Responsible"/>
                <field name="wa_account_id"/>
                <field name="whatsapp_tag_ids" string="Tags"/>
                <filter
                    name="filter_unassigned"
                    string="Unassigned"
                    domain="[('whatsapp_user_id', '=', False)]"
                />
                <filter
                    name="filter_mine"
                    string="My Chats"
                    domain="[('whatsapp_user_id', '=', uid)]"
                />
                <separator/>
                <group>
                    <filter
                        name="group_by_responsible"
                        string="Responsible"
                        context="{'group_by': 'whatsapp_user_id'}"
                    />
                    <filter
                        name="group_by_account"
                        string="WhatsApp Account"
                        context="{'group_by': 'wa_account_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="discuss_channel_action_whatsapp_assign" model="ir.actions.act_window">
        <field name="name">Assign Chats</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="discuss_channel_view_list_whatsapp"/>
        <field name="search_view_id" ref="discuss_channel_view_search_whatsapp"/>
        <field name="domain">[('channel_type', '=', 'whatsapp')]</field>
        <field name="context">{'search_default_filter_unassigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WhatsApp chats to assign</p>
            <p>Chats appear here when a customer writes to one of your WhatsApp accounts.</p>
        </field>
    </record>
</odoo>
