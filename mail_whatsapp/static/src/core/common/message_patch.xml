<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail_whatsapp.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-header')]//small[hasclass('o-mail-Message-date')]" position="after">
            <t t-if="showWhatsappMeta">
                <span
                    class="fa fa-whatsapp ms-1"
                    t-att-class="getWhatsappStatusClass()"
                    t-att-title="getWhatsappStatusTitle()"
                />
                <a
                    t-if="message.whatsappOriginName"
                    class="ms-1 small text-muted text-truncate"
                    style="max-width: 12rem;"
                    t-att-href="message.whatsappOriginUrl"
                    t-att-title="message.whatsappOriginName"
                    target="_blank"
                    t-esc="message.whatsappOriginName"
                />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Message-sidebar')]//small[hasclass('o-mail-Message-date')]" position="after">
            <t t-if="props.squashed and showWhatsappMeta">
                <span
                    class="fa fa-whatsapp d-block mt-1"
                    t-att-class="getWhatsappStatusClass()"
                    t-att-title="getWhatsappStatusTitle()"
                />
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Message-content')]/AttachmentList" position="before">
            <div
                t-if="message.hasWhatsappButtons and !state.isEditing"
                class="o_mail_whatsapp_buttons d-flex flex-column gap-1 mt-1 mb-1"
                t-att-class="{'align-items-end': isAlignedRight, 'align-items-start': !isAlignedRight}"
            >
                <t t-foreach="message.whatsappButtons" t-as="btn" t-key="btn_index">
                    <a
                        t-if="btn.url"
                        class="o_mail_whatsapp_button btn btn-sm btn-outline-success text-truncate"
                        t-att-href="btn.url"
                        t-att-title="btn.name"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <i class="fa fa-external-link me-1"/>
                        <t t-esc="btn.name"/>
                    </a>
                    <span
                        t-else=""
                        class="o_mail_whatsapp_button btn btn-sm btn-outline-secondary text-truncate disabled"
                        t-att-title="btn.name"
                    >
                        <t t-esc="btn.name"/>
                    </span>
                </t>
            </div>
        </xpath>
    </t>
</templates>
