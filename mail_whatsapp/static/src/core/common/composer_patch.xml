<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mail_whatsapp.Composer.actions" t-inherit="mail.Composer.actions" t-inherit-mode="extension">
        <xpath expr="//*[@name='root']" position="replace">
            <t t-if="thread?.channel_type === 'whatsapp' and !state.active"/>
            <t t-else="">$0</t>
        </xpath>
    </t>
    <t t-name="mail_whatsapp.Composer.quickActions" t-inherit="mail.Composer.quickActions" t-inherit-mode="extension">
        <xpath expr="//*[@name='root']" position="replace">
            <t t-if="thread?.channel_type === 'whatsapp' and !state.active"/>
            <t t-else="">$0</t>
        </xpath>
    </t>
    <t t-name="mail_whatsapp.Composer.extraActions" t-inherit="mail.Composer.extraActions" t-inherit-mode="extension">
        <xpath expr="//*[@name='root']" position="replace">
            <t t-if="thread?.channel_type === 'whatsapp' and !state.active"/>
            <t t-else="">$0</t>
        </xpath>
    </t>
</templates>
