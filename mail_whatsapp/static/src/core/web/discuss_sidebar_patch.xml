<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mail_whatsapp.DiscussSidebar" t-inherit="mail.DiscussSidebar" t-inherit-mode="extension">
        <xpath expr="//Dropdown[.//t[@t-call='mail.DiscussSidebar.startMeetingButton']]" position="attributes">
            <attribute name="t-if">store.discuss.isSidebarCompact and !store.discuss.whatsappFocus</attribute>
        </xpath>
        <xpath expr="//t[@t-call='mail.DiscussSidebar.startMeetingButton'][not(ancestor::Dropdown)]" position="attributes">
            <attribute name="t-else"></attribute>
            <attribute name="t-elif">!store.discuss.whatsappFocus</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='discussSidebarItems']" position="replace">
            <div t-if="store.discuss.whatsappFocus" class="o-mail-whatsapp-FocusSidebarHost d-flex flex-column flex-grow-1 min-h-0">
                <WhatsappFocusSidebar t-key="'whatsapp_focus_sidebar'"/>
            </div>
            <t t-else="">
                <t t-foreach="discussSidebarItems" t-as="item" t-key="item_index" t-component="item"/>
            </t>
        </xpath>
    </t>
</templates>
