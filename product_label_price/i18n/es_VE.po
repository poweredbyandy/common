#. module: product_label_price
#: model:ir.module.module,shortdesc:product_label_price.module_product_label_price
msgid "Product Label Price"
msgstr "Precio en etiquetas de producto"

#. module: product_label_price
#: model:ir.module.module,summary:product_label_price.module_product_label_price
msgid "Show or hide the price on PDF product labels"
msgstr "Muestra u oculta el precio en las etiquetas PDF del producto"

#. module: product_label_price
#: model:ir.model.fields,field_description:product_label_price.field_res_company__product_label_show_price
#: model:ir.model.fields,field_description:product_label_price.field_res_config_settings__product_label_show_price
msgid "Show Price on PDF Labels"
msgstr "Mostrar precio en etiquetas PDF"

#. module: product_label_price
#: model:ir.model.fields,help:product_label_price.field_res_company__product_label_show_price
msgid "If disabled, PDF product labels print without the price."
msgstr "Si se desactiva, las etiquetas PDF del producto se imprimen sin precio."

#. module: product_label_price
#: model_terms:ir.ui.view,arch_db:product_label_price.res_config_settings_view_form
msgid "Product Labels"
msgstr "Etiquetas de producto"

#. module: product_label_price
#: model_terms:ir.ui.view,arch_db:product_label_price.res_config_settings_view_form
msgid "Show price on PDF labels"
msgstr "Mostrar precio en etiquetas PDF"

#. module: product_label_price
#: model_terms:ir.ui.view,arch_db:product_label_price.res_config_settings_view_form
msgid "If disabled, PDF product labels print without the price. Barcodes and QR codes are unchanged."
msgstr "Si se desactiva, las etiquetas PDF se imprimen sin precio. Los códigos de barras y QR no cambian."
