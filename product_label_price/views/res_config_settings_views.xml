<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.product.label.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="product_general_settings" position="after">
                <block title="Product Labels" id="product_label_price_settings">
                    <setting
                        id="product_label_show_price_setting"
                        string="Show price on PDF labels"
                        help="If disabled, PDF product labels print without the price. Barcodes and QR codes are unchanged."
                    >
                        <field name="product_label_show_price"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
