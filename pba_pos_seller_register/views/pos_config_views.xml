<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.pba.pos.seller.register</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='has_active_session']" position="after">
                <field name="pba_seller_pos" invisible="1"/>
            </xpath>
            <xpath expr="//div[hasclass('o_notification_alert')][.//button[@name='open_ui']]" position="attributes">
                <attribute name="invisible">not has_active_session or pba_seller_pos</attribute>
            </xpath>
            <xpath expr="//field[@name='module_pos_hr']" position="attributes">
                <attribute name="readonly">has_active_session and not pba_seller_pos</attribute>
            </xpath>
        </field>
    </record>
</odoo>
