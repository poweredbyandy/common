<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_search_pba_configurator" model="ir.ui.view">
        <field name="name">product.template.search.pba.configurator</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Products">
                <field
                    name="name"
                    string="Product"
                    filter_domain="['|', '|', ('name', 'ilike', self), ('default_code', 'ilike', self), ('internal_code', 'ilike', self)]"
                />
                <field name="default_code"/>
                <field name="internal_code"/>
            </search>
        </field>
    </record>

    <record id="product_template_view_list_pba_configurator" model="ir.ui.view">
        <field name="name">product.template.list.pba.configurator</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Products" create="false" delete="false">
                <field name="image_128" widget="image" options="{'size': [40, 40]}"/>
                <field name="name" readonly="1"/>
                <field name="default_code" string="Referencia" readonly="1"/>
                <field name="internal_code" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="product_template_view_form_pba_configurator" model="ir.ui.view">
        <field name="name">product.template.form.pba.configurator</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Product" create="false" delete="false">
                <sheet>
                    <field
                        name="image_1920"
                        widget="image"
                        class="oe_avatar"
                        options="{'convert_to_webp': True, 'preview_image': 'image_128'}"
                    />
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_code" string="Referencia" readonly="1"/>
                            <field name="internal_code" readonly="1"/>
                        </group>
                    </group>
                    <group string="Fotos del sitio web" name="product_template_images">
                        <field
                            colspan="2"
                            name="product_template_image_ids"
                            class="o_website_sale_image_list"
                            context="{'default_name': name}"
                            mode="kanban"
                            add-label="Add Media"
                            nolabel="1"
                            widget="x2_many_media_viewer"
                            options="{'convert_to_webp': True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
