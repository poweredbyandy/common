<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_action_configurator" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_template_view_search_pba_configurator"/>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'list', 'view_id': ref('product_template_view_list_pba_configurator')}),
                   (0, 0, {'view_mode': 'form', 'view_id': ref('product_template_view_form_pba_configurator')})]"
        />
        <field name="context">{'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products found
            </p>
            <p>
                Open a product to update its main photo and website photos.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pba_product_configurator_root"
        name="Product Configurator"
        web_icon="product,static/description/icon.png"
        groups="pba_product_configurator.group_pba_product_configurator"
        sequence="45"
    />

    <menuitem
        id="menu_pba_product_configurator_products"
        name="Products"
        parent="menu_pba_product_configurator_root"
        action="product_template_action_configurator"
        sequence="10"
    />
</odoo>
