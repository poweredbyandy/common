<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pba_product_configurator" model="ir.module.category">
        <field name="name">Product Configurator</field>
        <field name="sequence">56</field>
    </record>

    <record id="group_pba_product_configurator" model="res.groups">
        <field name="name">PBA: Configurador de productos</field>
        <field name="category_id" ref="module_category_pba_product_configurator"/>
        <field name="comment">
            Permite gestionar la foto principal y las fotos del sitio web del producto.
            Muestra nombre, referencia y código interno en solo lectura.
            No permite crear, archivar ni eliminar productos.
        </field>

        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
