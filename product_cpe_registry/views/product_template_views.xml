<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_cpe_registry" model="ir.ui.view">
        <field name="name">product.template.form.cpe.registry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="cpe_registry" string="Venezuela">
                    <group>
                        <group>
                            <field name="cpe" />
                            <field name="sanitary_registry" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_cpe_registry" model="ir.ui.view">
        <field name="name">product.template.list.cpe.registry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="cpe" optional="hide" />
                <field name="sanitary_registry" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
