<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_pba_final_cost" model="ir.ui.view">
        <field name="name">product.template.tree.pba.final.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field
                    name="pba_final_cost"
                    string="Costo final"
                    optional="hide"
                    groups="pba_costs.group_pba_product_costs_tab"
                    widget="monetary"
                    options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                />
            </field>
        </field>
    </record>
    <record id="product_product_tree_view_pba_final_cost" model="ir.ui.view">
        <field name="name">product.product.tree.pba.final.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field
                    name="pba_final_cost"
                    string="Costo final"
                    optional="hide"
                    groups="pba_costs.group_pba_product_costs_tab"
                    widget="monetary"
                    options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                />
            </field>
        </field>
    </record>
</odoo>
