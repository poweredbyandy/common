<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pba_product_cost_history_view_list" model="ir.ui.view">
        <field name="name">pba.product.cost.history.list</field>
        <field name="model">pba.product.cost.history</field>
        <field name="arch" type="xml">
            <list string="Historial de costos" create="1" edit="1">
                <field name="date"/>
                <field name="product_tmpl_id" optional="hide"/>
                <field name="cost_type"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="operation_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="percent" widget="percentage"/>
                <field name="user_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="pba_product_cost_history_view_form" model="ir.ui.view">
        <field name="name">pba.product.cost.history.form</field>
        <field name="model">pba.product.cost.history</field>
        <field name="arch" type="xml">
            <form string="Historial de costo">
                <sheet>
                    <group>
                        <field name="product_tmpl_id"/>
                        <field name="cost_type"/>
                        <field name="date"/>
                        <field name="user_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="operation_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="percent" widget="percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
