<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pba_costs" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pba.costs</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="35"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="PBA Costos"
                    string="PBA Costos"
                    name="pba_costs"
                    groups="base.group_system"
                >
                    <block title="Costo final (fórmula global)">
                        <setting
                            string="Fórmula del costo final"
                            help="Expresión única para todos los productos. Ver ayuda en el campo para la lista de variables y ejemplos."
                        >
                            <field
                                name="pba_final_cost_formula"
                                widget="text"
                                placeholder="pba_last_cost + pba_cost_freight + ..."
                            />
                            <div class="text-muted small mt-3">
                                <p>
                                    <strong>Resumen:</strong> use exactamente los nombres de la ayuda del campo;
                                    operadores <code>+ - * / **</code> y paréntesis; funciones habituales
                                    (<code>min</code>, <code>max</code>, <code>abs</code>, <code>round</code>, <code>sum</code>, etc.).
                                </p>
                                <p>
                                    Los campos <code>pba_*_percent</code> están en escala 0–1 (0,10 = 10%).
                                </p>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
