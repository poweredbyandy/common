<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_credit_note_return" model="ir.ui.view">
        <field name="name">res.company.form.credit.note.return</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Devoluciones NC" name="pba_credit_note_return">
                    <group>
                        <field
                            name="pba_credit_note_return_picking_type_id"
                            options="{'no_create': True}"
                        />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
