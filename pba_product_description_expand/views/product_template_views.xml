<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_description_expand" model="ir.ui.view">
        <field name="name">product.template.form.description.expand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="class" add="o_pba_product_description_expand" separator=" "/>
            </form>
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="options">{'height': 250}</attribute>
            </xpath>
            <xpath expr="//field[@name='description_sale']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="rows">10</attribute>
            </xpath>
            <xpath expr="//page[@name='sales']/group[group[@name='description']]" position="attributes">
                <attribute name="col">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_purchase_description_expand" model="ir.ui.view">
        <field name="name">product.template.form.purchase.description.expand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_purchase']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="rows">10</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_stock_description_expand" model="ir.ui.view">
        <field name="name">product.template.form.stock.description.expand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_pickingin']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="rows">10</attribute>
            </xpath>
            <xpath expr="//field[@name='description_pickingout']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="rows">10</attribute>
            </xpath>
            <xpath expr="//field[@name='description_picking']" position="attributes">
                <attribute name="class" add="o_pba_expanded_description" separator=" "/>
                <attribute name="rows">10</attribute>
            </xpath>
        </field>
    </record>
</odoo>
