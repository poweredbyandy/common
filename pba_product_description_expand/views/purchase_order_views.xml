<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_view_form_description_expand" model="ir.ui.view">
        <field name="name">purchase.order.form.description.expand</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/form//page[@name='notes']/field[@name='name']"
                position="attributes"
            >
                <attribute name="widget">pba_product_description</attribute>
                <attribute name="rows">10</attribute>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_line_form2_description_expand" model="ir.ui.view">
        <field name="name">purchase.order.line.form2.description.expand</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="widget">pba_product_description</attribute>
                <attribute name="rows">10</attribute>
            </xpath>
        </field>
    </record>
</odoo>
