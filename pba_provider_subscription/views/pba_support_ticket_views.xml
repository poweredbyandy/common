<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pba_support_ticket_view_list" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.list</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <list
                string="Support Tickets"
                decoration-warning="state == 'pending_approval'"
                decoration-info="state == 'submitted'"
                decoration-primary="state == 'in_progress'"
                decoration-success="state == 'resolved'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="number" />
                <field name="name" />
                <field name="partner_id" />
                <field name="contact_name" />
                <field name="contact_email" optional="show" />
                <field name="client_user_login" optional="show" />
                <field name="priority" widget="priority" />
                <field name="state" widget="badge" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="pba_support_ticket_view_form" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.form</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button
                        name="action_set_submitted"
                        type="object"
                        string="Mark Submitted"
                        invisible="state != 'pending_approval'"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_in_progress"
                        type="object"
                        string="In Progress"
                        invisible="state not in ('submitted', 'pending_approval')"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_resolved"
                        type="object"
                        string="Resolve"
                        invisible="state not in ('submitted', 'in_progress')"
                    />
                    <button
                        name="action_set_cancelled"
                        type="object"
                        string="Cancel"
                        invisible="state in ('resolved', 'cancelled')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending_approval,submitted,in_progress,resolved"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Subject" />
                        </h1>
                        <h5>
                            <field name="number" readonly="1" />
                        </h5>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id" />
                            <field name="client_company_name" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group string="Sent By">
                            <field name="contact_name" />
                            <field name="contact_email" widget="email" />
                            <field name="contact_phone" widget="phone" />
                            <field name="client_user_login" />
                            <field name="priority" widget="priority" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" />
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_count" invisible="1" />
                            <field name="attachment_ids" widget="many2many_binary" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="pba_support_ticket_view_search" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.search</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Support Tickets">
                <field name="number" />
                <field name="name" />
                <field name="partner_id" />
                <field name="contact_name" />
                <field name="contact_email" />
                <field name="client_user_login" />
                <filter
                    string="Awaiting Client Approval"
                    name="pending_approval"
                    domain="[('state', '=', 'pending_approval')]"
                />
                <filter
                    string="Submitted"
                    name="submitted"
                    domain="[('state', '=', 'submitted')]"
                />
                <filter
                    string="In Progress"
                    name="in_progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    string="Resolved"
                    name="resolved"
                    domain="[('state', '=', 'resolved')]"
                />
                <filter
                    string="Sent to Support"
                    name="sent_to_support"
                    domain="[('state', 'in', ('submitted', 'in_progress', 'resolved'))]"
                />
                <separator />
                <filter
                    string="All except cancelled"
                    name="active_tickets"
                    domain="[('state', '!=', 'cancelled')]"
                />
                <group>
                    <filter
                        string="Customer"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Contact"
                        name="group_contact"
                        context="{'group_by': 'contact_name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="pba_support_ticket_action" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">pba.support.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_sent_to_support': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a support ticket or wait for customer submissions.
            </p>
        </field>
    </record>
</odoo>
