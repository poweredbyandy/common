<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pba_support_ticket_view_list" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.list</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <list
                string="Support Tickets"
                decoration-warning="state == 'pending_approval'"
                decoration-info="state == 'submitted'"
                decoration-primary="state == 'in_progress'"
                decoration-success="state == 'resolved'"
                decoration-muted="state == 'cancelled'"
            >
                <field name="number" />
                <field name="name" />
                <field name="category" />
                <field name="partner_id" />
                <field name="contact_name" />
                <field name="contact_email" optional="show" />
                <field name="client_user_login" optional="show" />
                <field name="priority" widget="priority" />
                <field name="state" widget="badge" />
                <field name="create_date" />
            </list>
        </field>
    </record>

    <record id="pba_support_ticket_view_kanban" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.kanban</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="state"
                class="o_kanban_small_column"
                records_draggable="1"
                sample="1"
                default_order="priority desc, create_date desc"
            >
                <field name="state" />
                <field name="priority" />
                <field name="partner_id" />
                <field name="number" />
                <field name="name" />
                <field name="category" />
                <field name="contact_name" />
                <field name="sla_estimated_label" />
                <field name="sla_deadline" />
                <field name="attachment_count" />
                <field name="priority_mismatch" />
                <progressbar
                    field="priority"
                    colors="{&quot;3&quot;: &quot;danger&quot;, &quot;2&quot;: &quot;warning&quot;, &quot;1&quot;: &quot;info&quot;, &quot;0&quot;: &quot;success&quot;}"
                />
                <templates>
                    <t t-name="card">
                        <field name="number" class="text-muted small" />
                        <field name="name" class="fw-bold fs-5" />
                        <field name="partner_id" />
                        <field name="contact_name" />
                        <field name="category" />
                        <div
                            t-if="record.sla_estimated_label.raw_value"
                            class="text-muted small"
                        >
                            SLA:
                            <field name="sla_estimated_label" />
                        </div>
                        <div
                            t-if="record.priority_mismatch.raw_value"
                            class="text-warning small"
                        >
                            Priority mismatch holgura
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center gap-1">
                                <field name="priority" widget="priority" />
                                <span
                                    t-if="record.attachment_count.raw_value"
                                    class="text-muted"
                                >
                                    <i class="fa fa-paperclip" />
                                    <t t-esc="record.attachment_count.value" />
                                </span>
                            </div>
                            <field
                                name="sla_deadline"
                                widget="remaining_days"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="pba_support_ticket_view_form" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.form</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
                <header>
                    <button
                        name="action_set_submitted"
                        type="object"
                        string="Mark Submitted"
                        invisible="state != 'pending_approval'"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_in_progress"
                        type="object"
                        string="In Progress"
                        invisible="state not in ('submitted', 'pending_approval')"
                        class="btn-primary"
                    />
                    <button
                        name="action_set_resolved"
                        type="object"
                        string="Resolve"
                        invisible="state not in ('submitted', 'in_progress')"
                    />
                    <button
                        name="action_set_cancelled"
                        type="object"
                        string="Cancel"
                        invisible="state in ('resolved', 'cancelled')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending_approval,submitted,in_progress,resolved"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Subject" />
                        </h1>
                        <h5>
                            <field name="number" readonly="1" />
                        </h5>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id" />
                            <field name="client_company_name" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group string="Sent By">
                            <field name="contact_name" />
                            <field name="contact_email" widget="email" />
                            <field name="contact_phone" widget="phone" />
                            <field name="client_user_login" />
                            <field name="category" />
                            <field name="client_priority" widget="priority" />
                            <field name="priority" widget="priority" />
                            <field name="priority_reviewed" />
                            <field name="priority_mismatch" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" />
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_count" invisible="1" />
                            <field name="attachment_ids" widget="many2many_binary" />
                        </page>
                        <page string="SLA" name="sla">
                            <div
                                class="alert alert-info"
                                role="alert"
                                invisible="category == 'improvement'"
                            >
                                Deadlines use business hours only (Mon-Fri, configured workday)
                                and skip registered unavailable days.
                            </div>
                            <div
                                class="alert alert-secondary"
                                role="alert"
                                invisible="category != 'improvement'"
                            >
                                Improvement tickets do not track SLA or elapsed time.
                            </div>
                            <group invisible="category == 'improvement'">
                                <group string="Resolution target">
                                    <field name="sla_estimated_label" />
                                    <field name="sla_deadline" />
                                    <field name="sla_hours" />
                                    <field name="sla_holgura_hours" />
                                    <field name="client_priority" widget="priority" />
                                    <field name="priority" widget="priority" />
                                    <field name="priority_reviewed" />
                                    <field name="priority_mismatch" />
                                </group>
                                <group string="Computed from customer flow">
                                    <field name="stage_duration_hint" />
                                    <field name="stage_duration_label" />
                                    <field name="wait_label" />
                                    <field name="process_label" />
                                    <field name="stage_entered_at" />
                                </group>
                            </group>
                            <group>
                                <group string="Stage timestamps">
                                    <field name="date_pending_approval" />
                                    <field name="date_submitted" />
                                    <field name="date_in_progress" />
                                    <field name="date_resolved" />
                                    <field name="date_cancelled" />
                                </group>
                                <group string="Customer rating">
                                    <field name="is_rated" invisible="1" />
                                    <field name="rating" />
                                    <field name="rating_date" />
                                    <field name="rating_text" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="pba_support_ticket_view_search" model="ir.ui.view">
        <field name="name">pba.support.ticket.view.search</field>
        <field name="model">pba.support.ticket</field>
        <field name="arch" type="xml">
            <search string="Support Tickets">
                <field name="number" />
                <field name="name" />
                <field name="category" />
                <field name="partner_id" />
                <field name="contact_name" />
                <field name="contact_email" />
                <field name="client_user_login" />
                <filter
                    string="Awaiting Client Approval"
                    name="pending_approval"
                    domain="[('state', '=', 'pending_approval')]"
                />
                <filter
                    string="Submitted"
                    name="submitted"
                    domain="[('state', '=', 'submitted')]"
                />
                <filter
                    string="In Progress"
                    name="in_progress"
                    domain="[('state', '=', 'in_progress')]"
                />
                <filter
                    string="Resolved"
                    name="resolved"
                    domain="[('state', '=', 'resolved')]"
                />
                <filter
                    string="Sent to Support"
                    name="sent_to_support"
                    domain="[('state', 'in', ('submitted', 'in_progress', 'resolved'))]"
                />
                <separator />
                <filter
                    string="All except cancelled"
                    name="active_tickets"
                    domain="[('state', '!=', 'cancelled')]"
                />
                <group>
                    <filter
                        string="Customer"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Category"
                        name="group_category"
                        context="{'group_by': 'category'}"
                    />
                    <filter
                        string="Contact"
                        name="group_contact"
                        context="{'group_by': 'contact_name'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="pba_support_ticket_action" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">pba.support.ticket</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_tickets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a support ticket or wait for customer submissions.
            </p>
        </field>
    </record>
</odoo>
