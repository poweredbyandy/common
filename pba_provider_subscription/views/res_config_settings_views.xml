<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_pba_sla" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pba.sla</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="Customer Support"
                    name="pba_provider_subscription"
                    groups="pba_provider_subscription.group_support_manager"
                >
                    <block title="Business hours" name="pba_sla_business_hours">
                        <setting
                            string="Workday start"
                            help="Default Monday-Friday from 9:00."
                        >
                            <field name="pba_sla_hour_from" />
                        </setting>
                        <setting
                            string="Workday end"
                            help="Default Monday-Friday until 17:00."
                        >
                            <field name="pba_sla_hour_to" />
                        </setting>
                        <setting
                            string="Timezone"
                            help="Used to calculate business hours and deadlines."
                        >
                            <field name="pba_sla_timezone" />
                        </setting>
                    </block>
                    <block title="SLA by priority (business hours)" name="pba_sla_settings">
                        <setting
                            string="Low priority"
                            help="Default 2 business weeks (80h)."
                        >
                            <field name="pba_sla_hours_low" />
                            <div class="text-muted">Business hours to resolve</div>
                        </setting>
                        <setting
                            string="Normal priority"
                            help="Default 1 business week (40h)."
                        >
                            <field name="pba_sla_hours_normal" />
                            <div class="text-muted">Business hours to resolve</div>
                        </setting>
                        <setting
                            string="High priority"
                            help="Default 2 business days (16h)."
                        >
                            <field name="pba_sla_hours_high" />
                            <div class="text-muted">Business hours to resolve</div>
                        </setting>
                        <setting
                            string="Urgent priority"
                            help="Default 5 business hours."
                        >
                            <field name="pba_sla_hours_urgent" />
                            <div class="text-muted">Business hours to resolve</div>
                        </setting>
                        <setting
                            string="Priority mismatch holgura"
                            help="Extra business time when customer overstates urgency. Default 1 business day (8h)."
                        >
                            <field name="pba_sla_priority_mismatch_hours" />
                            <div class="text-muted">
                                Extra business hours added to the SLA deadline
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_pba_provider_config_settings" model="ir.actions.act_window">
        <field name="name">SLA Configuration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'pba_provider_subscription'}</field>
    </record>
</odoo>