<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_pba_provider_subscription" model="ir.module.category">
        <field name="name">Provider Subscription</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_support_user" model="res.groups">
        <field name="name">Support User</field>
        <field name="category_id" ref="module_category_pba_provider_subscription" />
    </record>

    <record id="group_support_manager" model="res.groups">
        <field name="name">Support Manager</field>
        <field name="category_id" ref="module_category_pba_provider_subscription" />
        <field
            name="implied_ids"
            eval="[(4, ref('group_support_user'))]"
        />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="pba_support_ticket_rule_user" model="ir.rule">
        <field name="name">Support Ticket: internal users</field>
        <field name="model_id" ref="model_pba_support_ticket" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_support_user'))]" />
    </record>

    <record id="pba_support_ticket_rule_portal" model="ir.rule">
        <field name="name">Support Ticket: portal partner</field>
        <field name="model_id" ref="model_pba_support_ticket" />
        <field
            name="domain_force"
        >[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    </record>

    <record id="pba_api_key_rule_support_manager" model="ir.rule">
        <field name="name">API Keys: support manager can manage client keys</field>
        <field name="model_id" ref="base.model_res_users_apikeys" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_support_manager'))]" />
    </record>
</odoo>
