<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_mail_gmail_user_fetch" model="ir.cron">
        <field name="name">Mail Gmail User: Fetch thread replies</field>
        <field name="model_id" ref="model_mail_gmail_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_incoming()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_mail_gmail_user_token_check" model="ir.cron">
        <field name="name">Mail Gmail User: Check Gmail tokens</field>
        <field name="model_id" ref="model_mail_gmail_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_tokens()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
