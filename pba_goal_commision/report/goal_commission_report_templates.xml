<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rpt_goal_comm_pending">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="partner">
                <t t-set="report" t-value="report_data.get(partner.id, {})"/>
                <t t-set="invoices_data" t-value="report.get('invoices', [])"/>
                <t t-call="web.external_layout" t-att-lang="report_lang">
                    <div class="article o_report_layout_standard o_table_standard" style="font-size: 11px; line-height: 1.35; color: #212529;">
                        <p style="margin: 0 0 8px; padding-bottom: 6px; border-bottom: 2px solid #714B67;">
                            <strong style="color: #714B67; font-size: 14px;">Comisiones Pendientes por Meta</strong>
                            <span style="color: #6c757d;"> · </span>
                            <strong t-field="partner.name"/>
                            <span style="color: #6c757d;"> · Fecha: <span t-esc="report_date"/></span>
                        </p>
                        <t t-if="not report.get('has_data')">
                            <p style="margin: 0; color: #6c757d;">No hay comisiones pendientes para este vendedor.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-sm table-borderless" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #dee2e6; color: #6c757d;">
                                        <th style="text-align: left; padding: 2px 8px 2px 0;">Factura</th>
                                        <th style="text-align: left; padding: 2px 8px 2px 0;">Cliente</th>
                                        <th style="text-align: right; padding: 2px 8px 2px 0;">Monto venta</th>
                                        <th style="text-align: center; padding: 2px 8px 2px 0;">%</th>
                                        <th style="text-align: left; padding: 2px 8px 2px 0;">Detalle</th>
                                        <th style="text-align: right; padding: 2px 0;">Comisión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="invoices_data" t-as="inv_data">
                                        <t t-foreach="inv_data.get('lines', [])" t-as="line">
                                            <tr style="border-bottom: 1px solid #f0f0f0;">
                                                <td style="padding: 2px 8px 2px 0;">
                                                    <strong t-if="line_index == 0" t-esc="inv_data['name']"/>
                                                </td>
                                                <td style="padding: 2px 8px 2px 0;">
                                                    <span t-if="line_index == 0" t-esc="inv_data['partner']"/>
                                                </td>
                                                <td style="padding: 2px 8px 2px 0; text-align: right;">
                                                    <t t-if="line_index == 0">
                                                        <span t-esc="'{:,.2f}'.format(inv_data['sale_amount'])"/>
                                                        <span t-esc="inv_data['sale_currency']"/>
                                                    </t>
                                                </td>
                                                <td style="padding: 2px 8px 2px 0; text-align: center;">
                                                    <span t-if="line_index == 0" t-esc="'%.2f' % inv_data['percent']"/>
                                                </td>
                                                <td style="padding: 2px 8px 2px 0;" t-esc="line['description']"/>
                                                <td style="padding: 2px 0; text-align: right;">
                                                    <strong t-esc="'{:,.2f}'.format(line['commission_amount'])"/>
                                                    <span t-esc="line['currency']"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="rpt_goal_comm_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="bill">
                <t t-set="voucher" t-value="report_data.get(bill.id, {})"/>
                <t t-call="web.external_layout" t-att-lang="report_lang">
                    <div class="article o_report_layout_standard o_table_standard" style="font-size: 11px; line-height: 1.35; color: #212529;">
                        <p style="margin: 0 0 8px; padding-bottom: 6px; border-bottom: 2px solid #714B67;">
                            <strong style="color: #714B67; font-size: 14px;">Comprobante de Comision por Meta</strong>
                            <span style="color: #6c757d;"> · </span>
                            <strong t-esc="voucher.get('vendor_name')"/>
                        </p>
                        <table class="table table-sm table-borderless" style="width: 100%; border-collapse: collapse; font-size: 10px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #dee2e6; color: #6c757d;">
                                    <th style="text-align: left; padding: 2px 8px 2px 0;">Factura</th>
                                    <th style="text-align: left; padding: 2px 8px 2px 0;">Cliente</th>
                                    <th style="text-align: center; padding: 2px 8px 2px 0;">%</th>
                                    <th style="text-align: left; padding: 2px 8px 2px 0;">Detalle</th>
                                    <th style="text-align: right; padding: 2px 0;">Comisión</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="voucher.get('invoices_data', [])" t-as="inv_data">
                                    <t t-foreach="inv_data.get('lines', [])" t-as="line">
                                        <tr style="border-bottom: 1px solid #f0f0f0;">
                                            <td style="padding: 2px 8px 2px 0;">
                                                <strong t-if="line_index == 0" t-esc="inv_data.get('name')"/>
                                            </td>
                                            <td style="padding: 2px 8px 2px 0;">
                                                <span t-if="line_index == 0" t-esc="inv_data.get('partner')"/>
                                            </td>
                                            <td style="padding: 2px 8px 2px 0; text-align: center;">
                                                <span t-if="line_index == 0" t-esc="'%.2f' % inv_data.get('percent', 0.0)"/>
                                            </td>
                                            <td style="padding: 2px 8px 2px 0;" t-esc="line.get('description')"/>
                                            <td style="padding: 2px 0; text-align: right;">
                                                <strong t-esc="'{:,.2f}'.format(line.get('commission_amount', 0.0))"/>
                                                <span t-esc="line.get('currency')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
