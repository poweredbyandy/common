<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_account_group" model="ir.actions.act_window">
        <field name="name">Account Groups</field>
        <field name="res_model">account.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account.view_account_group_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an account group
            </p>
            <p>
                Account groups organize the chart of accounts by code prefixes.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_action_account_group"
        name="Account Groups"
        action="action_account_group"
        parent="account.account_account_menu"
        sequence="2"
        groups="account.group_account_readonly"
    />

    <record id="account.menu_action_tax_form" model="ir.ui.menu">
        <field name="sequence">3</field>
    </record>
</odoo>
