<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pba_alert_list" model="ir.ui.view">
        <field name="name">pba.alert.list</field>
        <field name="model">pba.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="event_type"/>
                <field name="schedule_label"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_pba_alert_form" model="ir.ui.view">
        <field name="name">pba.alert.form</field>
        <field name="model">pba.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_alerts"
                        string="Generar alertas"
                        type="object"
                        class="btn-primary"
                        invisible="not active"
                        confirm="Se crearán actividades para los documentos pendientes de esta alerta que aún no las tengan. ¿Continuar?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre de la alerta"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="event_type"/>
                            <field
                                name="delay_days"
                                invisible="event_type not in ('draft_invoice_old', 'quotation_no_followup')"
                            />
                            <field name="activity_type_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="summary" placeholder="Texto de la actividad"/>
                        </group>
                    </group>
                    <group string="Programación automática">
                        <group>
                            <field name="schedule_enabled"/>
                            <label for="interval_number" string="Ejecutar cada"/>
                            <div class="o_row">
                                <field name="interval_number" class="oe_inline" readonly="not schedule_enabled"/>
                                <field name="interval_type" class="oe_inline" readonly="not schedule_enabled"/>
                            </div>
                            <field name="schedule_label" invisible="1"/>
                            <field name="last_run"/>
                            <field name="cron_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Descripción de la actividad">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pba_alert_search" model="ir.ui.view">
        <field name="name">pba.alert.search</field>
        <field name="model">pba.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="event_type"/>
                <field name="user_ids"/>
                <filter name="filter_active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archivadas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_event_type" string="Suceso" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pba_alert" model="ir.actions.act_window">
        <field name="name">Alertas</field>
        <field name="res_model">pba.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure qué sucesos generan actividades y a quién notificar.
            </p>
            <p>
                Asigne usuarios en cada alerta. Las actividades se crean automáticamente
                según el tipo de suceso configurado.
            </p>
        </field>
    </record>
</odoo>
