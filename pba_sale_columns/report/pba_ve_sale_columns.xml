<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document_ve_pba_columns"
        inherit_id="l10n_ve_seniat_sale.report_saleorder_document_l10n_ve_no_fiscal"
    >
        <xpath expr="//th[@name='th_default_code']" position="after">
            <th name="th_internal_code" class="text-start text-nowrap">
                CÓD. INT.
            </th>
            <th name="th_product_brand" class="text-start text-nowrap">MARCA</th>
        </xpath>
        <xpath expr="//td[@name='td_default_code']" position="after">
            <td name="td_internal_code" class="text-start text-nowrap">
                <span t-field="line.product_id.internal_code" />
            </td>
            <td name="td_product_brand" class="text-start text-nowrap">
                <span t-field="line.product_id.product_brand_id" />
            </td>
        </xpath>
    </template>
</odoo>
