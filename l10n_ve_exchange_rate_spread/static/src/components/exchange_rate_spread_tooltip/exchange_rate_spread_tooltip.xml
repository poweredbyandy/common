<templates xml:space="preserve">
    <t
        t-name="l10n_ve_exchange_rate_spread.ExchangeRateTooltipExtension"
        t-inherit="l10n_ve_exchange_rates.ExchangeRateTooltip"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('o_exchange_rate_content')]" position="inside">
            <div
                t-if="state.spreads and state.spreads.length"
                class="border-top mt-1 pt-1"
            >
                <div class="fw-bold px-3 py-1">Spreads</div>
                <div class="px-3 pb-1">
                    <table class="table table-sm table-borderless m-0">
                        <tbody>
                            <t
                                t-foreach="state.spreads"
                                t-as="spread"
                                t-key="spread_index"
                            >
                                <tr>
                                    <td class="p-1">
                                        <t t-esc="spread.label" />
                                    </td>
                                    <td class="p-1 text-end">
                                        <t t-if="spread.has_rate">
                                            <span
                                                t-att-class="'badge ' + (spread.positive ? 'text-bg-warning' : 'text-bg-success')"
                                                t-esc="formatSpread(spread.spread)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted small">
                                                Sin tasa
                                            </span>
                                        </t>
                                    </td>
                                </tr>
                                <tr t-if="spread.has_rate">
                                    <td
                                        class="p-1 small text-muted"
                                        colspan="2"
                                        t-esc="formatDetail(spread)"
                                    />
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
    </t>
</templates>
