<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_advance_payment_inv_inherit" model="ir.ui.view">
        <field name="name">sale.advance.payment.inv.inherit.wizard</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">
            <!-- Ocultar las opciones de anticipo -->
            <xpath expr="//field[@name='advance_payment_method']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Reemplazar el footer completo -->
            <xpath expr="//footer" position="replace">
                <footer>
                    <button name="create_invoices_and_stay" type="object"
                        string="Crear Factura"
                        class="btn-primary" data-hotkey="q"/>
                    <button name="create_invoices" type="object"
                        string="Crear y Ver Factura"
                        class="btn-secondary" data-hotkey="w"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </xpath>
        </field>
    </record>

</odoo>
