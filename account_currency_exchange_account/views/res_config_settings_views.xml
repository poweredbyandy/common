<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.currency.exchange.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expense_currency_exchange_account_id']/parent::div" position="after">
                <div class="row mt8">
                    <label for="currency_exchange_account_id" string="Cuenta única" class="col-lg-4 o_light_label"/>
                    <field name="currency_exchange_account_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
