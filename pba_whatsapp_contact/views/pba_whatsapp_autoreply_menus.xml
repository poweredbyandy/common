<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pba_whatsapp_autoreply_config_view_form" model="ir.ui.view">
        <field name="name">pba.whatsapp.autoreply.config.form</field>
        <field name="model">pba.whatsapp.autoreply.config</field>
        <field name="arch" type="xml">
            <form string="Respuestas automáticas">
                <sheet>
                    <div class="oe_title">
                        <h1>Respuestas automáticas WhatsApp</h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="whatsapp_autoreply_enabled"/>
                        </group>
                        <group invisible="not whatsapp_autoreply_enabled">
                            <field
                                name="whatsapp_autoreply_default_message"
                                placeholder="Estamos fuera de horario. Le responderemos a la brevedad."
                            />
                        </group>
                    </group>
                    <notebook invisible="not whatsapp_autoreply_enabled">
                        <page string="Horarios" name="rules">
                            <field name="whatsapp_autoreply_rule_ids" nolabel="1" context="{'default_company_id': company_id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="monday"/>
                                    <field name="tuesday"/>
                                    <field name="wednesday"/>
                                    <field name="thursday"/>
                                    <field name="friday"/>
                                    <field name="saturday"/>
                                    <field name="sunday"/>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                    <field name="message"/>
                                    <field name="active"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pba_whatsapp_autoreply_config_action" model="ir.actions.server">
        <field name="name">Respuestas automáticas</field>
        <field name="model_id" ref="model_pba_whatsapp_autoreply_config"/>
        <field name="state">code</field>
        <field name="code">action = env["pba.whatsapp.autoreply.config"].action_open_autoreply()</field>
    </record>

    <menuitem
        id="menu_pba_whatsapp_autoreply"
        name="Respuestas automáticas"
        parent="mail.menu_configuration"
        action="pba_whatsapp_autoreply_config_action"
        sequence="20"
    />
</odoo>
