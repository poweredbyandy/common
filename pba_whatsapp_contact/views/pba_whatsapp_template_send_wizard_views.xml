<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pba_whatsapp_template_send_wizard_view_form" model="ir.ui.view">
        <field name="name">pba.whatsapp.template.send.wizard.form</field>
        <field name="model">pba.whatsapp.template.send.wizard</field>
        <field name="arch" type="xml">
            <form string="WhatsApp">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list create="0" delete="0" edit="0">
                        <field name="sequence" column_invisible="1"/>
                        <field name="template_id"/>
                        <field
                            name="send_state"
                            widget="badge"
                            decoration-success="send_state == 'sent'"
                            decoration-muted="send_state == 'pending'"
                        />
                        <field name="sent_date" optional="show"/>
                        <field name="sent_user_id" optional="hide"/>
                        <field name="body_preview" optional="show"/>
                        <button
                            name="action_send_whatsapp"
                            type="object"
                            string="Enviar"
                            icon="fa-whatsapp"
                            class="btn-link"
                        />
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
