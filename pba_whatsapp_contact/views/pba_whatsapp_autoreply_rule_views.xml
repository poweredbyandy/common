<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pba_whatsapp_autoreply_rule_view_list" model="ir.ui.view">
        <field name="name">pba.whatsapp.autoreply.rule.list</field>
        <field name="model">pba.whatsapp.autoreply.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="pba_whatsapp_autoreply_rule_view_form" model="ir.ui.view">
        <field name="name">pba.whatsapp.autoreply.rule.form</field>
        <field name="model">pba.whatsapp.autoreply.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Horario laboral"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Horario">
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Días">
                        <group>
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                            <field name="thursday"/>
                        </group>
                        <group>
                            <field name="friday"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                        </group>
                    </group>
                    <group string="Mensaje">
                        <field name="message" nolabel="1" placeholder="Gracias por escribirnos. En breve le atenderemos."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
