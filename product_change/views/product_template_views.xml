<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_product_change" model="ir.ui.view">
        <field name="name">product.template.form.product.change</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button" position="before">
                <button
                    name="%(product_change_wizard_action)d"
                    type="action"
                    string="Change Type / UoM"
                    groups="stock.group_stock_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
