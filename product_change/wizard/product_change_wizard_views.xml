<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_change_wizard_view_form" model="ir.ui.view">
        <field name="name">product.change.wizard.form</field>
        <field name="model">product.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Product">
                <group>
                    <div colspan="2" class="oe_title">
                        <p>
                            Choose what to change. Sales, purchases and invoices
                            are kept. Incoming and outgoing stock is rebuilt or
                            generated when the product becomes a good or starts
                            tracking quantity.
                        </p>
                    </div>
                    <field name="product_count"/>
                    <field name="product_tmpl_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="current_type"/>
                    <field name="current_is_storable"/>
                    <field name="current_uom_id"/>
                    <field name="same_uom_category" invisible="1"/>
                </group>
                <group string="Product Type">
                    <field name="change_type"/>
                    <field name="new_type" invisible="not change_type" required="change_type"/>
                </group>
                <group string="Inventory Tracking">
                    <field name="change_tracking"/>
                    <field name="new_tracking" invisible="not change_tracking" required="change_tracking"/>
                </group>
                <group string="Unit of Measure">
                    <field name="change_uom"/>
                    <field name="new_uom_id" invisible="not change_uom" required="change_uom"/>
                    <field name="convert_uom_qty" invisible="not change_uom or not same_uom_category"/>
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Apply"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button special="cancel" string="Discard" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_change_wizard_action" model="ir.actions.act_window">
        <field name="name">Change Type / UoM</field>
        <field name="res_model">product.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form,list</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="product_change_wizard_action_product" model="ir.actions.act_window">
        <field name="name">Change Type / UoM</field>
        <field name="res_model">product.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
