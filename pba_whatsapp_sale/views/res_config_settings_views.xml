<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="WhatsApp Ventas">
                    <setting id="whatsapp_template_quotation_setting" string="Plantilla presupuesto">
                        <field name="whatsapp_template_sale_quotation_id"/>
                    </setting>
                    <setting id="whatsapp_template_confirmed_setting" string="Plantilla pedido confirmado">
                        <field name="whatsapp_template_sale_confirmed_id"/>
                    </setting>
                    <setting id="whatsapp_template_delivery_setting" string="Plantilla entrega">
                        <field name="whatsapp_template_delivery_done_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
