<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pba_product_catalog" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pba.product.catalog</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="stock_packaging" position="after">
                <setting
                    id="pba_product_catalog_warehouse"
                    string="Almacén del catálogo"
                    help="Almacén usado para calcular las cantidades disponibles mostradas en el catálogo de productos.">
                    <field
                        name="pba_product_catalog_warehouse_id"
                        options="{'no_create': True}"/>
                </setting>
                <setting
                    id="pba_product_catalog_price_tax_included"
                    string="Precios del catálogo con impuestos"
                    help="Si está activo, las listas de precios del catálogo se muestran con impuestos incluidos.">
                    <field name="pba_product_catalog_price_tax_included"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
