<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inter_company_stock" model="ir.ui.view">
        <field name="name">purchase.order.form.inter.company.stock</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany_vendor" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <field name="is_intercompany_vendor" column_invisible="1"/>
                <field name="ic_qty_available"
                         string="Vendor On Hand"
                         optional="show"
                         column_invisible="not parent.is_intercompany_vendor"/>
                <field name="ic_virtual_available"
                         string="Vendor Forecast"
                         optional="hide"
                         column_invisible="not parent.is_intercompany_vendor"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="is_intercompany_vendor" invisible="1"/>
                <field name="ic_qty_available" invisible="not is_intercompany_vendor"/>
                <field name="ic_virtual_available" invisible="not is_intercompany_vendor"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_inter_company_link" model="ir.ui.view">
        <field name="name">purchase.order.form.inter.company.link</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ic_show_sync_button" invisible="1"/>
                <button name="action_ic_sync_sale_order"
                        type="object"
                        string="Sync Inter-Company Sale"
                        class="btn-secondary"
                        invisible="not ic_show_sync_button"
                        data-hotkey="shift+i"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="ic_sale_order_id" readonly="1" invisible="not ic_sale_order_id"/>
                <field name="auto_sale_order_id" readonly="1" invisible="not auto_sale_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
