<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inter_company_qty_widget" model="ir.ui.view">
        <field name="name">sale.order.form.inter.company.qty.widget</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock_qty"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='order_line']/list/field[@name='display_qty_widget']" position="after">
                <field name="ic_free_qty_by_company" column_invisible="True"/>
            </xpath>
            <xpath expr="//page/field[@name='order_line']/form//field[@name='display_qty_widget']" position="after">
                <field name="ic_free_qty_by_company" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_inter_company_link" model="ir.ui.view">
        <field name="name">sale.order.form.inter.company.link</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ic_show_sync_button" invisible="1"/>
                <button name="action_ic_sync_purchase_order"
                        type="object"
                        string="Sync Inter-Company Purchase"
                        class="btn-secondary"
                        invisible="not ic_show_sync_button"
                        data-hotkey="shift+i"/>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="ic_purchase_order_display"
                         readonly="1"
                         invisible="not ic_purchase_order_display"/>
            </xpath>
        </field>
    </record>
</odoo>
