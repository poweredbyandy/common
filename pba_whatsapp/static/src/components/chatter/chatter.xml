<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="pba_whatsapp.ChatterTopbar" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button
                class="o-mail-Chatter-whatsapp btn text-nowrap me-1"
                type="button"
                t-att-class="{
                    'btn-secondary': true,
                    'my-2': !props.compactHeight
                }"
                t-att-disabled="!state.thread.canPostMessage and props.threadId"
                t-on-click="onClickWhatsapp"
                title="WhatsApp"
            >
                <i class="fa fa-whatsapp text-success" role="img" aria-label="WhatsApp"/>
                <span> WhatsApp</span>
            </button>
        </xpath>
        <xpath
            expr="//t[@t-if='state.composerType']/SuggestedRecipientsList"
            position="before"
        >
            <div
                t-if="state.composerType === 'gateway'"
                class="d-flex align-items-center o-gap-8 px-3 pb-2"
                style="margin-left:48px"
            >
                <span class="small text-muted">Tipo:</span>
                <select
                    class="form-select form-select-sm"
                    style="max-width: 170px;"
                    t-att-value="whatsappState.mode"
                    t-on-change="onWhatsappModeChange"
                >
                    <option value="message">Mensaje</option>
                    <option value="template">Plantilla</option>
                </select>
                <select
                    t-if="whatsappState.mode === 'template'"
                    class="form-select form-select-sm"
                    style="max-width: 280px;"
                    t-att-value="whatsappState.selectedTemplateId or ''"
                    t-on-change="onWhatsappTemplateChange"
                >
                    <option value="">Selecciona plantilla</option>
                    <option
                        t-foreach="whatsappState.templates"
                        t-as="template"
                        t-key="template.id"
                        t-att-value="template.id"
                    >
                        <t t-esc="template.name"/>
                    </option>
                </select>
            </div>
        </xpath>
    </t>
</templates>
