<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="pba_whatsapp.ChatterTopbar"
        t-inherit="mail_gateway.ChatterTopbar"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-gateway')]" position="replace">
            <button
                class="o-mail-Chatter-whatsapp btn text-nowrap me-1"
                type="button"
                t-att-class="{
                    'btn-secondary': true,
                    'my-2': !props.compactHeight
                }"
                t-att-disabled="!state.thread.canPostMessage and props.threadId"
                t-on-click="onClickWhatsapp"
                title="WhatsApp"
            >
                <i class="fa fa-whatsapp text-success" role="img" aria-label="WhatsApp"/>
                <span> WhatsApp</span>
            </button>
        </xpath>
        <xpath
            expr="//t[@t-if=&quot;state.composerType === 'gateway' and state.thread.gateway_followers.length&quot;]"
            position="replace"
        />
    </t>
</templates>
