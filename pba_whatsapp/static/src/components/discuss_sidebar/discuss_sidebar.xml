<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="pba_whatsapp.DiscussSidebarOperator"
        t-inherit="mail.DiscussSidebarChannel.main"
        t-inherit-mode="extension"
    >
        <xpath expr="//span[hasclass('o-mail-DiscussSidebarChannel-itemName')]" position="replace">
            <div
                t-if="!store.discuss.isSidebarCompact"
                class="o-mail-DiscussSidebarChannel-itemName mx-2 d-flex flex-column text-truncate"
                t-att-class="thread.selfMember?.message_unread_counter > 0 and !thread.isMuted ? 'o-item-unread fw-bolder' : 'text-muted'"
            >
                <span class="text-truncate"><t t-esc="thread.displayName"/></span>
                <span
                    t-if="thread.channel_type === 'gateway' and thread.operator"
                    class="o-xsmaller text-muted text-truncate"
                >
                    Atiende: <t t-esc="thread.operator.name"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
