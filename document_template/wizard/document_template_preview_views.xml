<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_template_preview_view_form" model="ir.ui.view">
        <field name="name">document.template.preview.form</field>
        <field name="model">document.template.preview</field>
        <field name="arch" type="xml">
            <form string="Document Preview">
                <sheet>
                    <div class="oe_title">
                        <h3>
                            Preview of
                            <field
                                name="document_template_id"
                                readonly="1"
                                nolabel="1"
                                options="{'no_open': True}"
                            />
                        </h3>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not error_msg">
                        <field name="error_msg" widget="text"/>
                    </div>
                    <field name="no_record" invisible="1"/>
                    <field name="model_id" invisible="1"/>
                    <field name="has_header" invisible="1"/>
                    <field name="has_footer" invisible="1"/>
                    <group>
                        <label for="resource_ref" string="Test Record"/>
                        <field
                            name="resource_ref"
                            nolabel="1"
                            widget="reference"
                            options="{'hide_model': True, 'model_field': 'model_id', 'no_create': True, 'no_open': True}"
                            readonly="False"
                            force_save="1"
                            invisible="no_record"
                        />
                        <b invisible="not no_record" class="text-warning">
                            No record for this model
                        </b>
                    </group>
                    <div class="o_document_template_preview_canvas mt-3">
                        <div class="o_document_template_page_sheet">
                            <div
                                class="o_document_template_preview_header"
                                invisible="not has_header"
                            >
                                <field
                                    name="header_html"
                                    widget="html"
                                    nolabel="1"
                                    options="{'safe': True}"
                                />
                            </div>
                            <div class="o_document_template_preview_body">
                                <field
                                    name="body_html"
                                    widget="html"
                                    nolabel="1"
                                    options="{'safe': True}"
                                />
                            </div>
                            <div
                                class="o_document_template_preview_footer"
                                invisible="not has_footer"
                            >
                                <field
                                    name="footer_html"
                                    widget="html"
                                    nolabel="1"
                                    options="{'safe': True}"
                                />
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button
                        name="action_download_pdf"
                        type="object"
                        string="Download PDF"
                        class="btn-primary"
                        invisible="no_record or not resource_ref"
                        data-hotkey="q"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
