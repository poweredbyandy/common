<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_availability_color" model="ir.ui.view">
        <field name="name">sale.order.form.availability.color</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock_qty"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='order_line']/form//field[@name='display_qty_widget']" position="after">
                <field name="qty_availability_state" invisible="1"/>
            </xpath>
            <xpath expr="//page/field[@name='order_line']/list/field[@name='display_qty_widget']" position="after">
                <field name="qty_availability_state" column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
