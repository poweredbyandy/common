<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pba_pos_ship_later_default.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]/div[hasclass('d-flex')][1]" position="inside">
            <button
                t-if="pos.config.ship_later"
                class="button js_shipping_address btn btn-light btn-lg d-flex align-items-center text-start w-100 lh-sm"
                t-att-class="{ 'highlight active text-action': currentOrder and !currentOrder.isPbaShippingLocal() }"
                t-on-click="clickShippingAddress"
            >
                <i class="fa fa-map-marker me-2 flex-shrink-0" />
                <span class="pba-shipping-address-label">
                    <t t-esc="pbaShippingAddressLabel"/>
                </span>
            </button>
        </xpath>
    </t>
</templates>
