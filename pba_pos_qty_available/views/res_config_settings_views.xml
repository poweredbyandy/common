<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pba.pos.qty.available</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="margin_and_cost" position="after">
                <setting
                    id="pba_pos_show_product_qty_available"
                    string="Show available quantity in catalog"
                    help="Display free-to-use stock on product cards. Cached for offline use and refreshed when online."
                >
                    <field name="pos_show_product_qty_available"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
