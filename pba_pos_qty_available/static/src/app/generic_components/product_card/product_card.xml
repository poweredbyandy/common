<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="before">
            <div
                t-if="showQtyAvailable"
                t-att-class="qtyAvailableClass"
                t-att-title="availableQtyLabel"
            >
                <span t-esc="availableQtyDisplay"/>
            </div>
        </xpath>
    </t>
</templates>
