<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_website_form" model="ir.ui.view">
        <field name="name">website.form.inherit.web.sale.auto.order</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <group name="domain" position="inside">
                <field name="auto_order_pricelist_id"/>
                <field name="auto_order_button_color" widget="color"/>
                <field name="auto_order_button_text_color" widget="color"/>
                <field name="auto_order_success_message"/>
                <field name="auto_order_lang_id" domain="[('id', 'in', language_ids)]"/>
            </group>
        </field>
    </record>
</odoo>
