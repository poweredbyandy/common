<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="auto_order_page" name="Scan and Order">
        <t t-call="web.layout">
            <t t-set="title">Scan and Order</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0f172a"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <script type="text/javascript">
                    odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;
                    if (!/(^|;\s)tz=/.test(document.cookie)) {
                        const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
                        document.cookie = `tz=${userTZ}; path=/`;
                    }
                </script>
                <t t-call-assets="web.assets_frontend_minimal" t-css="false"/>
                <t t-call-assets="web_sale_auto_order.assets_kiosk"/>
                <t t-call-assets="web_sale_auto_order.zxing_assets" t-css="false" defer_load="True"/>
            </t>
            <t t-set="auto_order_button_color" t-value="website._get_auto_order_button_color()"/>
            <div id="wrap" class="o_wsao_page o_wsao_nchrome">
                <style>
                    body { margin: 0; background: #0f172a; }
                    .o_wsao_boot {
                        position: fixed;
                        inset: 0;
                        z-index: 50;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        background: rgba(15, 23, 42, 0.92);
                        color: #e2e8f0;
                        gap: 0.85rem;
                        transition: opacity 0.25s ease;
                    }
                    .o_wsao_boot.o_wsao_boot--hide {
                        opacity: 0;
                        pointer-events: none;
                    }
                    .o_wsao_boot_spinner {
                        width: 2.4rem;
                        height: 2.4rem;
                        border: 3px solid rgba(255, 255, 255, 0.2);
                        border-top-color: <t t-esc="auto_order_button_color"/>;
                        border-radius: 50%;
                        animation: o-wsao-spin 0.7s linear infinite;
                    }
                    @keyframes o-wsao-spin { to { transform: rotate(360deg); } }
                    .o_wsao_shell {
                        min-height: 100vh;
                        color: #e2e8f0;
                        font-family: system-ui, sans-serif;
                        padding: 1rem;
                    }
                </style>
                <div id="o_wsao_boot" class="o_wsao_boot">
                    <div class="o_wsao_boot_spinner"/>
                    <p>Loading...</p>
                </div>
                <div class="o_wsao_shell">
                    <h1 style="margin:0 0 0.5rem;font-size:1.35rem;">Scan and Order</h1>
                    <p style="margin:0 0 1rem;opacity:0.85;">Starting scanner...</p>
                </div>
                <owl-component
                    name="web_sale_auto_order.AutoOrder"
                    t-att-props="json.dumps(auto_order_props)"
                />
                <script type="text/javascript">
                    (function () {
                        var boot = document.getElementById("o_wsao_boot");
                        function hideBoot() {
                            if (!boot) {
                                return;
                            }
                            boot.classList.add("o_wsao_boot--hide");
                            window.setTimeout(function () {
                                if (boot &amp;&amp; boot.parentNode) {
                                    boot.parentNode.removeChild(boot);
                                }
                            }, 280);
                        }
                        document.addEventListener("DOMContentLoaded", function () {
                            window.setTimeout(hideBoot, 3500);
                        });
                        window.addEventListener("load", hideBoot);
                    })();
                </script>
            </div>
        </t>
    </template>
</odoo>
