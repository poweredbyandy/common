<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="auto_order_page" name="Scan and Order">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="no_copyright" t-value="True"/>
            <t t-set="pageName" t-value="'o_wsao_nchrome'"/>
            <t t-set="additional_title">Scan and Order</t>
            <t t-set="head">
                <t t-call-assets="web_sale_auto_order.zxing_assets" t-css="false" defer_load="True"/>
            </t>
            <t t-set="auto_order_button_color" t-value="website._get_auto_order_button_color()"/>
            <div id="wrap" class="o_wsao_page">
                <style>
                    .o_wsao_boot{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#0f172a;color:#e2e8f0;gap:0.85rem}
                    .o_wsao_boot_spinner{width:2.4rem;height:2.4rem;border:3px solid rgba(255,255,255,.2);border-top-color:#10b981;border-radius:50%;animation:o-wsao-spin .7s linear infinite}
                    @keyframes o-wsao-spin{to{transform:rotate(360deg)}}
                </style>
                <div id="o_wsao_boot" class="o_wsao_boot">
                    <div class="o_wsao_boot_spinner" t-attf-style="border-top-color: {{ auto_order_button_color }};"/>
                    <p>Loading...</p>
                </div>
                <owl-component
                    name="web_sale_auto_order.AutoOrder"
                    t-att-props="json.dumps(auto_order_props)"
                />
            </div>
        </t>
    </template>
</odoo>
