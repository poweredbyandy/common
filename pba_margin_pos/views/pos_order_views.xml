<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_margin" model="ir.ui.view">
        <field name="name">pos.order.form.margin.pba</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']/list//field[@name='margin']" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
            <xpath expr="//field[@name='lines']/list//field[@name='margin_percent']" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
            <xpath expr="//label[@for='margin']" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
            <xpath expr="//label[@for='margin']/following-sibling::div[1]" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_pos_order_pivot_margin" model="ir.ui.view">
        <field name="name">pos.order.pivot.margin.pba</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='margin']" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
            <xpath expr="//field[@name='margin_percent']" position="attributes">
                <attribute name="groups">pba_margin.group_pba_see_margin</attribute>
            </xpath>
        </field>
    </record>
</odoo>
