<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.pagomovil</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group string="Pago Móvil" invisible="code != 'pagomovil'">
                    <field name="pagomovil_holder"/>
                    <field name="pagomovil_vat"
                           required="code == 'pagomovil' and state != 'disabled'"/>
                    <field name="pagomovil_phone"
                           required="code == 'pagomovil' and state != 'disabled'"/>
                    <field name="pagomovil_bank"
                           required="code == 'pagomovil' and state != 'disabled'"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
