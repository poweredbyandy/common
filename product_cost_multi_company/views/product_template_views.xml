<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_cost_multi_company" model="ir.ui.view">
        <field name="name">product.template.form.cost.multi.company</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute name="help">Si está vacío, el producto es visible para todas las compañías y el costo se comparte entre ellas.</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_action_share_standard_price" model="ir.actions.server">
        <field name="name">Replicar costo a otras compañías</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_multi_company'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_share_standard_price_across_companies()
        </field>
    </record>
</odoo>
